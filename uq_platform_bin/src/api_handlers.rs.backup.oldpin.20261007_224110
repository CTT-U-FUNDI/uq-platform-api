/// GET /api/account/preferences/{uq_number}
/// Retourne les prÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©fÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©rences du compte
pub async fn account_preferences_get(path: web::Path<String>) -> HttpResponse {
    let uq_number = path.into_inner();
    let db_path = format!("data/users/{}.db", uq_number.replace("-", "_").to_lowercase());
    
    if !std::path::Path::new(&db_path).exists() {
        return HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": format!("Compte introuvable: {}", uq_number)
        }));
    }
    
    let conn = match rusqlite::Connection::open(&db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur DB: {}", e)
        })),
    };
    
    // Lire les prÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©fÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©rences (avec fallback sur valeurs par dÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©faut)
    let display_unit: String = conn.query_row(
        "SELECT value FROM settings WHERE key = 'display_unit'",
        [],
        |row| row.get(0)
    ).unwrap_or_else(|_| "FXB".to_string());
    
    let theme: String = conn.query_row(
        "SELECT value FROM settings WHERE key = 'theme'",
        [],
        |row| row.get(0)
    ).unwrap_or_else(|_| "dark".to_string());
    
    let language: String = conn.query_row(
        "SELECT value FROM settings WHERE key = 'language'",
        [],
        |row| row.get(0)
    ).unwrap_or_else(|_| "fr".to_string());
    
    // VÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©rifier si un PIN est configurÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©
    let pin_enabled: bool = conn.query_row(
        "SELECT value FROM settings WHERE key = 'pin_enabled'",
        [],
        |row| row.get::<_, String>(0)
    ).map(|v| v == "true").unwrap_or(false);
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "uq_number": uq_number,
        "preferences": {
            "display_unit": display_unit,
            "theme": theme,
            "language": language,
            "pin_enabled": pin_enabled,
        }
    }))
}

