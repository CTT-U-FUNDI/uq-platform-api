pub async fn uq_generate_address(body: web::Json<serde_json::Value>) -> HttpResponse {
    use uq_blockchain::uq_address::{generate_uq_number, generate_uq_email, generate_uq_pseudo};

    let country = body.get("country").and_then(|v| v.as_str()).unwrap_or("RDC");
    let nom = body.get("nom").and_then(|v| v.as_str()).unwrap_or("");
    let prenom = body.get("prenom").and_then(|v| v.as_str()).unwrap_or("");
    let position = body.get("position").and_then(|v| v.as_u64()).unwrap_or(1);

    if nom.is_empty() || prenom.is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "nom et prenom requis"
        }));
    }

    let uq_number = generate_uq_number(country, nom, prenom, position);
    let uq_email = generate_uq_email(prenom, 0);
    let uq_pseudo = generate_uq_pseudo(prenom, 0);

    HttpResponse::Ok().json(json!({
        "status": "success",
        "uq_number": uq_number,
        "uq_email": uq_email,
        "uq_pseudo": uq_pseudo,
        "country": country,
        "nom": nom,
        "prenom": prenom,
        "position": position
