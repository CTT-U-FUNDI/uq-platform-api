/// CrÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©e un nouveau type personnalisÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©
pub async fn custom_type_create(body: web::Json<serde_json::Value>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    
    let owner_id = body.get("owner_id").and_then(|v| v.as_str()).unwrap_or("");
    let name = body.get("name").and_then(|v| v.as_str()).unwrap_or("");
    let emoji = body.get("emoji").and_then(|v| v.as_str()).unwrap_or("ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â­ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â");
    let color = body.get("color").and_then(|v| v.as_str()).unwrap_or("#4A9EFF");
    let description = body.get("description").and_then(|v| v.as_str()).unwrap_or("");
    let fields = body.get("fields").and_then(|v| v.as_str()).unwrap_or("[]");
    
    if name.is_empty() {
        return HttpResponse::BadRequest().json(json!({"status": "error", "message": "name requis"}));
    }
    
    let id = db.create_custom_type(owner_id, name, emoji, color, description, fields);
    
    if id.is_empty() {
        return HttpResponse::BadRequest().json(json!({"status": "error", "message": "Creation echouee"}));
    }
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "type_id": id
    }))
}

