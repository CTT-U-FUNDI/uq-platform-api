/// GET /api/fxb/origin/{trace_key}
/// VÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©rifie l'origine d'un FXB
pub async fn fixorb_get_origin(path: web::Path<String>) -> HttpResponse {
    let trace_key = path.into_inner();

    let db_path = "data/users/uq_00000001.db";
    let conn = match rusqlite::Connection::open(db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("DB: {}", e)
        })),
    };

    // ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â°ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¸ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚ÂÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â§ INIT : crÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©er la table si elle n'existe pas
    let _ = crate::fxb_tracer::init_fxb_origins_table(&conn);

    match crate::fxb_tracer::verifier_origine(&conn, &trace_key) {
        Ok(origin) => HttpResponse::Ok().json(json!({
            "status": "success",
            "origin": origin
        })),
        Err(e) => HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": e
        })),
    }
}

/// GET /api/fxb/origins/{recipient_uq}
/// Liste les origines reÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â§ues par un utilisateur
pub async fn fixorb_list_origins(path: web::Path<String>) -> HttpResponse {
    let recipient_uq = path.into_inner();

    let db_path = "data/users/uq_00000001.db";
    let conn = match rusqlite::Connection::open(db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("DB: {}", e)
        })),
    };

    // ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â°ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¸ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚ÂÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â§ INIT : crÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©er la table si elle n'existe pas
    let _ = crate::fxb_tracer::init_fxb_origins_table(&conn);

    let mut stmt = match conn.prepare(
        "SELECT trace_key, timestamp, amount_points, treasury_uq, cadenas_owner
         FROM fxb_origins WHERE recipient_uq = ?1
         ORDER BY timestamp DESC LIMIT 100"
    ) {
        Ok(s) => s,
        Err(_) => return HttpResponse::Ok().json(json!({
            "status": "success",
            "origins": []
        })),
    };

    let rows = stmt.query_map(rusqlite::params![recipient_uq], |row| {
        Ok(json!({
            "trace_key": row.get::<_, String>(0)?,
            "timestamp": row.get::<_, i64>(1)?,
            "amount_points": row.get::<_, i64>(2)?,
            "treasury_uq": row.get::<_, String>(3)?,
            "cadenas_owner": row.get::<_, String>(4)?,
        }))
    });

    let mut origins = Vec::new();
    if let Ok(r) = rows {
        for row in r.flatten() {
            origins.push(row);
        }
    }

    HttpResponse::Ok().json(json!({
        "status": "success",
        "recipient": recipient_uq,
        "total": origins.len(),
        "origins": origins
