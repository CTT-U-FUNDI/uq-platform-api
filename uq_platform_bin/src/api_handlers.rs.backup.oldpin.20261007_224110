/// CrÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©e un nouvel ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©lÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©ment Zando
pub async fn zando_item_create(body: web::Json<serde_json::Value>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    
    let shop_id = body
        .get("shop_id")
        .and_then(|v| v.as_str())
        .or_else(|| body.get("seller_id").and_then(|v| v.as_str()))
        .unwrap_or("");
    let item_type = body.get("type").and_then(|v| v.as_str()).unwrap_or("text");
    let media_urls = body.get("media_urls").and_then(|v| v.as_str()).unwrap_or("[]");
    let title = body.get("title").and_then(|v| v.as_str()).unwrap_or("");
    let description = body.get("description").and_then(|v| v.as_str()).unwrap_or("");
    let price_fxb = body.get("price_fxb").and_then(|v| v.as_u64()).unwrap_or(0);
    let price_usd = body.get("price_usd").and_then(|v| v.as_f64()).unwrap_or(0.0);
    let category = body.get("category").and_then(|v| v.as_str()).unwrap_or("general");
    let commission_enabled = body.get("commission_enabled").and_then(|v| v.as_bool()).unwrap_or(false);
    let commission_rate = body.get("commission_rate").and_then(|v| v.as_u64()).unwrap_or(0) as u32;
    
    let id = db.create_shop_item(
        shop_id, item_type, media_urls, title, description,
        price_fxb, price_usd, category, commission_enabled, commission_rate,
    );
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "item_id": id
    }))
}

