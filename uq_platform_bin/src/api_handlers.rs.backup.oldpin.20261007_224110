            eprintln!("ÃƒÂ°Ã…Â¸Ã¢â‚¬ÂÃ‚Â Appareil rÃƒÆ’Ã‚Â©voquÃƒÆ’Ã‚Â© : {} ({} sessions)", device, count);
            HttpResponse::Ok().json(json!({
                "status": "success",
                "message": "Appareil rÃƒÆ’Ã‚Â©voquÃƒÆ’Ã‚Â©",
                "revoked_count": count
            }))
        },
        Err(e) => HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur rÃƒÆ’Ã‚Â©vocation: {}", e)
