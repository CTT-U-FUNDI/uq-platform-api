pub async fn verification_status(req: actix_web::HttpRequest, path: web::Path<String>) -> HttpResponse {
    // ðŸ” SÃ‰CURITÃ‰ (vague 1) â€” USER : accÃ¨s Ã  SES donnÃ©es (ou owner)
    // (handler sans paramètre de chemin : contrôle JWT simple)
    // 🔐 SÉCURITÉ (vague 1) — USER : accès à SES données (ou owner)
    let __cible = path.to_string();
    if let Err(r) = crate::auth_guard::exiger_soi_ou_owner(&req, &__cible) { return r; }

    let uq_number = path.into_inner();
    
    let db_path = format!("data/users/{}.db", uq_number.replace("-", "_").to_lowercase());
    if !std::path::Path::new(&db_path).exists() {
        return HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": "Compte introuvable"
        }));
    }
    
    if let Ok(conn) = rusqlite::Connection::open(&db_path) {
        if let Ok((verrouille, est_verifie)) = conn.query_row::<(i64, i64), _, _>(
            "SELECT verrouille, est_verifie FROM cadenas_verification WHERE id = 1",
            [],
            |row| Ok((row.get(0)?, row.get(1)?)),
        ) {
            let status = if est_verifie == 1 && verrouille == 0 {
                "verified"
            } else if verrouille == 1 {
                "not_verified"
            } else {
                "pending"
            };
            
            return HttpResponse::Ok().json(json!({
                "status": status,
                "verified": est_verifie == 1,
                "deverrouille": verrouille == 0
            }));
        }
    }
    
    HttpResponse::Ok().json(json!({
        "status": "not_verified",
        "verified": false,
        "deverrouille": false
    }))
}





