fn validate_transfer_amounts(amount_points: u64, fee_points: u64) -> Result<(u64, u64), HttpResponse> {
    if amount_points == 0 {
        return Err(HttpResponse::BadRequest().json(json!({
            "status": "error",
            "code": "INVALID_AMOUNT",
            "message": "Le montant doit ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Âªtre > 0"
        })));
    }

    if fee_points > amount_points / 100 {
        return Err(HttpResponse::BadRequest().json(json!({
            "status": "error",
            "code": "INVALID_FEE",
            "message": "Les frais ne peuvent pas dÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©passer 1% du montant"
        })));
    }

    let total_cost = amount_points.checked_add(fee_points).ok_or_else(|| {
        HttpResponse::BadRequest().json(json!({
            "status": "error",
            "code": "OVERFLOW",
            "message": "Montant total trop ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©levÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©"
        }))
    })?;

    if total_cost > i64::MAX as u64 {
        return Err(HttpResponse::BadRequest().json(json!({
            "status": "error",
            "code": "AMOUNT_TOO_HIGH",
            "message": "Montant dÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©passe la limite autorisÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©e"
        })));
    }

    Ok((amount_points, fee_points))
}


