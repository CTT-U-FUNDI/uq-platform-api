pub async fn uq_search_pseudos(query: web::Query<std::collections::HashMap<String, String>>) -> HttpResponse {
    let search = query.get("search").map(|s| s.to_lowercase()).unwrap_or_default();
    
    if search.len() < 3 {
        return HttpResponse::Ok().json(json!({ "status": "success", "pseudos": [] }));
    }
    
    let idx = crate::uq_index::UqIndex::shared("uq_index.db");
    let all = idx.search_pseudos(&search);
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "pseudos": all
