        Ok(None) => {
            return HttpResponse::BadRequest().json(json!({
                "status": "error",
                "message": "Challenge expire"
            }));
        },
        Err(e) => {
            return HttpResponse::InternalServerError().json(json!({
                "status": "error",
                "message": e
            }));
        },
    }

    // 2. Verifier que la credential existe
    // (Dans une vraie implementation, on verifie la signature cryptographique)
    let _ = credential_id;
    let _ = signature;

    // 3. Retourner un token de session
    // Pour simplifier, on genere un token simple
    let token = format!("webauthn_{}_{}", uq_number, chrono::Utc::now().timestamp());

    HttpResponse::Ok().json(json!({
        "status": "success",
        "message": "Biometrie validee",
        "token": token,
        "uq_number": uq_number
    }))
}

/// POST /api/webauthn/transaction/begin
/// Genere un challenge pour valider une transaction
pub async fn webauthn_transaction_begin(body: web::Json<serde_json::Value>) -> HttpResponse {
    let uq_number = body.get("uq_number").and_then(|v| v.as_str()).unwrap_or("");
    let transaction_id = body.get("transaction_id").and_then(|v| v.as_str()).unwrap_or("tx");

    if uq_number.is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "uq_number requis"
        }));
    }

    let db_path = format!("data/users/{}.db", uq_number.replace("-", "_").to_lowercase());

    if !std::path::Path::new(&db_path).exists() {
        return HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": "Compte introuvable"
        }));
    }

    let conn = match rusqlite::Connection::open(&db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur DB: {}", e)
        })),
    };

    let _ = crate::webauthn_manager::init_webauthn_table(&conn);

    let challenge = crate::webauthn_manager::generate_challenge();

    if let Err(e) = crate::webauthn_manager::store_challenge(&conn, &challenge, uq_number, &format!("tx:{}", transaction_id)) {
        return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": e
        }));
    }

    HttpResponse::Ok().json(json!({
        "status": "success",
        "challenge": challenge,
        "timeout": 60000,
        "userVerification": "required"
    }))
}

/// POST /api/webauthn/transaction/complete
/// Valide une transaction biometrique
pub async fn webauthn_transaction_complete(body: web::Json<serde_json::Value>) -> HttpResponse {
    let uq_number = body.get("uq_number").and_then(|v| v.as_str()).unwrap_or("");
    let challenge = body.get("challenge").and_then(|v| v.as_str()).unwrap_or("");
    let transaction_id = body.get("transaction_id").and_then(|v| v.as_str()).unwrap_or("tx");

    if uq_number.is_empty() || challenge.is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "Parametres manquants"
        }));
    }

    let db_path = format!("data/users/{}.db", uq_number.replace("-", "_").to_lowercase());

    let conn = match rusqlite::Connection::open(&db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur DB: {}", e)
        })),
    };

    match crate::webauthn_manager::verify_challenge(&conn, challenge) {
        Ok(Some((user, action))) => {
            if user != uq_number || action != format!("tx:{}", transaction_id) {
                return HttpResponse::BadRequest().json(json!({
                    "status": "error",
                    "message": "Challenge invalide"
                }));
            }
        },
        Ok(None) => {
            return HttpResponse::BadRequest().json(json!({
                "status": "error",
                "message": "Challenge expire"
            }));
        },
        Err(e) => {
            return HttpResponse::InternalServerError().json(json!({
                "status": "error",
                "message": e
            }));
        },
    }

    HttpResponse::Ok().json(json!({
        "status": "success",
        "message": "Transaction validee par biometrie",
        "validated": true
    }))
}

