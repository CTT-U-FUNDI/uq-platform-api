/// GET /api/account/devices/{uq_number}
/// Liste les appareils connectÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©s
pub async fn account_devices_list(req: actix_web::HttpRequest, path: web::Path<String>) -> HttpResponse {
    // ðŸ” SÃ‰CURITÃ‰ (vague 1) â€” USER : accÃ¨s Ã  SES donnÃ©es (ou owner)
    // (handler sans paramètre de chemin : contrôle JWT simple)
    // 🔐 SÉCURITÉ (vague 1) — USER : accès à SES données (ou owner)
    let __cible = path.to_string();
    if let Err(r) = crate::auth_guard::exiger_soi_ou_owner(&req, &__cible) { return r; }

    let uq_number = path.into_inner();
    let db_path = format!("data/users/{}.db", uq_number.replace("-", "_").to_lowercase());
    
    if !std::path::Path::new(&db_path).exists() {
        return HttpResponse::NotFound().json(json!({"status": "error", "message": "Compte introuvable"}));
    }
    
    let conn = match rusqlite::Connection::open(&db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({"status": "error", "message": format!("{}", e)})),
    };
    
    // RÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©cupÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©rer depuis security_log les derniÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¨res connexions uniques
    let mut stmt = match conn.prepare(
        "SELECT DISTINCT device, ip, MAX(created_at) as last_seen 
         FROM security_log 
         WHERE device IS NOT NULL 
         GROUP BY device 
         ORDER BY last_seen DESC 
         LIMIT 20"
    ) {
        Ok(s) => s,
        Err(_) => return HttpResponse::Ok().json(json!({"status": "success", "devices": []})),
    };
    
    let rows = stmt.query_map([], |row| {
        Ok(json!({
            "device": row.get::<_, String>(0)?,
            "ip": row.get::<_, Option<String>>(1)?.unwrap_or_default(),
            "last_seen": row.get::<_, i64>(2)?,
        }))
    });
    
    let mut devices = Vec::new();
    if let Ok(r) = rows {
        for row in r {
            if let Ok(v) = row { devices.push(v); }
        }
    }
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "total": devices.len(),
        "devices": devices
    }))
}

