/// RÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©cupÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¨re le prix du BTC depuis CoinGecko
async fn fetch_btc_price() -> f64 {
    let url = "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd";
    
    match reqwest::get(url).await {
        Ok(resp) => {
            match resp.json::<serde_json::Value>().await {
                Ok(json) => {
                    json.get("bitcoin")
                        .and_then(|b| b.get("usd"))
                        .and_then(|v| v.as_f64())
                        .unwrap_or(95000.0)
                }
                Err(_) => 95000.0
            }
        }
        Err(_) => 95000.0
    }
}

