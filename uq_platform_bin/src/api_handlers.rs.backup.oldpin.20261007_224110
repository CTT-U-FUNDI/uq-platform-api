pub async fn chat_send(req: actix_web::HttpRequest, body: web::Json<serde_json::Value>) -> HttpResponse {
    // ðŸ” SÃ‰CURITÃ‰ (vague 1) â€” USER : JWT obligatoire
    if let Err(r) = crate::auth_guard::exiger_auth(&req) { return r; }

    let db = Database::shared("uq_platform_db.json");
    let sender = body.get("sender").and_then(|v| v.as_str()).unwrap_or("");
    let recipient = body.get("recipient").and_then(|v| v.as_str()).unwrap_or("");
    let content = body.get("content").and_then(|v| v.as_str()).unwrap_or("");
    if sender.is_empty() || recipient.is_empty() || content.trim().is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "sender, recipient et content requis"
        }));
    }
    let id = db.send_message(sender, recipient, content.trim());
    HttpResponse::Ok().json(json!({"status": "success", "sent": true, "message_id": id}))
}

#[derive(serde::Deserialize)]
pub struct ChatThreadQuery {
    pub me: String,
}

pub async fn chat_messages(req: actix_web::HttpRequest, path: web::Path<String>,
    query: web::Query<ChatThreadQuery>,) -> HttpResponse {
    // ðŸ” SÃ‰CURITÃ‰ (vague 1) â€” USER : JWT obligatoire
    // 🔐 SÉCURITÉ (vague 1) — USER : accès à SES données (ou owner)
    // 🔐 SÉCURITÉ (vague 1) — USER : JWT obligatoire (le contrôle de
    // propriété de l'objet {id} reste à la charge du handler)
    if let Err(r) = crate::auth_guard::exiger_auth(&req) { return r; }

    let peer = path.into_inner();
    let me = query.me.trim();
    if me.is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "parametre me requis"
        }));
    }
    let db = Database::shared("uq_platform_db.json");
    let messages = db.get_messages_between(me, &peer);
    HttpResponse::Ok().json(json!({
        "status": "success",
        "peer": peer,
        "messages": messages
    }))
}

pub async fn chat_inbox(req: actix_web::HttpRequest, path: web::Path<String>) -> HttpResponse {
    // ðŸ” SÃ‰CURITÃ‰ (vague 1) â€” USER : JWT obligatoire
    // 🔐 SÉCURITÉ (vague 1) — USER : accès à SES données (ou owner)
    let __cible = path.to_string();
    if let Err(r) = crate::auth_guard::exiger_soi_ou_owner(&req, &__cible) { return r; }

    let user_id = path.into_inner();
    if user_id.trim().is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "user_id requis"
        }));
    }
    let db = Database::shared("uq_platform_db.json");
    let conversations = db.get_chat_inbox(&user_id);
    HttpResponse::Ok().json(json!({
        "status": "success",
        "conversations": conversations,
        "total": conversations.len()
    }))
}

