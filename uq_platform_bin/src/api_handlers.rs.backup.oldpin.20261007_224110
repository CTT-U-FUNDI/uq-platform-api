pub async fn exchange_order(body: web::Json<serde_json::Value>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    let seller = body.get("seller").and_then(|v| v.as_str()).unwrap_or("trader");
    let amount = body.get("amount").and_then(|v| v.as_u64()).unwrap_or(0);
    let side = body.get("side").and_then(|v| v.as_str()).unwrap_or("buy");
    let price = body.get("price_usd").and_then(|v| v.as_u64()).unwrap_or(100);
    let desc = format!("P2P {} {} FXB @ ${:.2}", side, amount, price as f64 / 100.0);
    db.publish_offer(seller, &desc, price.max(1), amount.max(1));
    let order_id = format!("ord_{}", chrono::Utc::now().timestamp());
    HttpResponse::Ok().json(json!({"status":"success","order_created":true,"order_id": order_id}))
