            "status": "error",
            "message": format!("Erreur: {}", e)
        })),
    };
    
    let (bubbles, points, frozen): (i64, i64, i64) = conn.query_row(
        "SELECT bubbles, points, COALESCE(frozen_points, 0) FROM balance WHERE id = 1",
        [],
        |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
