/// POST /api/webauthn/register/begin
/// Genere un challenge pour l'enregistrement d'une nouvelle passkey
pub async fn webauthn_register_begin(body: web::Json<serde_json::Value>) -> HttpResponse {
    let uq_number = body.get("uq_number").and_then(|v| v.as_str()).unwrap_or("");

    if uq_number.is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "uq_number requis"
        }));
    }

    let db_path = format!("data/users/{}.db", uq_number.replace("-", "_").to_lowercase());

    if !std::path::Path::new(&db_path).exists() {
        return HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": "Compte introuvable"
        }));
    }

    let conn = match rusqlite::Connection::open(&db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur DB: {}", e)
        })),
    };

    let _ = crate::webauthn_manager::init_webauthn_table(&conn);

    let challenge = crate::webauthn_manager::generate_challenge();

    if let Err(e) = crate::webauthn_manager::store_challenge(&conn, &challenge, uq_number, "register") {
        return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": e
        }));
    }

    HttpResponse::Ok().json(json!({
        "status": "success",
        "challenge": challenge,
        "rp": {
            "name": "UQ Platform",
            "id": "localhost"
        },
        "user": {
            "id": uq_number,
            "name": uq_number,
            "displayName": uq_number
        },
        "pubKeyCredParams": [
            { "type": "public-key", "alg": -7 },   // ES256
            { "type": "public-key", "alg": -257 }  // RS256
        ],
        "timeout": 60000,
        "attestation": "none",
        "authenticatorSelection": {
            "userVerification": "required",
            "residentKey": "preferred"
        }
    }))
}

/// POST /api/webauthn/register/complete
/// Enregistre la credential apres validation du challenge
pub async fn webauthn_register_complete(body: web::Json<serde_json::Value>) -> HttpResponse {
    let uq_number = body.get("uq_number").and_then(|v| v.as_str()).unwrap_or("");
    let challenge = body.get("challenge").and_then(|v| v.as_str()).unwrap_or("");
    let credential_id = body.get("credential_id").and_then(|v| v.as_str()).unwrap_or("");
    let public_key_b64 = body.get("public_key").and_then(|v| v.as_str()).unwrap_or("");
    let device_name = body.get("device_name").and_then(|v| v.as_str()).unwrap_or("Appareil");

    if uq_number.is_empty() || challenge.is_empty() || credential_id.is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "Parametres manquants"
        }));
    }

    let db_path = format!("data/users/{}.db", uq_number.replace("-", "_").to_lowercase());

    let conn = match rusqlite::Connection::open(&db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur DB: {}", e)
        })),
    };

    let _ = crate::webauthn_manager::init_webauthn_table(&conn);

    // 1. Verifier le challenge
    match crate::webauthn_manager::verify_challenge(&conn, challenge) {
        Ok(Some((user, action))) => {
            if user != uq_number || action != "register" {
                return HttpResponse::BadRequest().json(json!({
                    "status": "error",
                    "message": "Challenge invalide"
                }));
            }
        },
        Ok(None) => {
            return HttpResponse::BadRequest().json(json!({
                "status": "error",
                "message": "Challenge expire ou invalide"
            }));
        },
        Err(e) => {
            return HttpResponse::InternalServerError().json(json!({
                "status": "error",
                "message": e
            }));
        },
    }

    // 2. Sauvegarder la credential
    let pub_key_bytes = public_key_b64.as_bytes().to_vec();

    if let Err(e) = crate::webauthn_manager::save_credential(
        &conn,
        credential_id,
        &pub_key_bytes,
        device_name,
    ) {
        return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": e
        }));
    }

    HttpResponse::Ok().json(json!({
        "status": "success",
        "message": "Biometrie activee avec succes"
    }))
}

/// POST /api/webauthn/login/begin
/// Genere un challenge pour le login biometrique
pub async fn webauthn_login_begin(body: web::Json<serde_json::Value>) -> HttpResponse {
    let uq_number = body.get("uq_number").and_then(|v| v.as_str()).unwrap_or("");

    if uq_number.is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "uq_number requis"
        }));
    }

    let db_path = format!("data/users/{}.db", uq_number.replace("-", "_").to_lowercase());

    if !std::path::Path::new(&db_path).exists() {
        return HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": "Compte introuvable"
        }));
    }

    let conn = match rusqlite::Connection::open(&db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur DB: {}", e)
        })),
    };

    let _ = crate::webauthn_manager::init_webauthn_table(&conn);

    let count = crate::webauthn_manager::count_credentials(&conn);

    if count == 0 {
        return HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": "Aucune biometrie enregistree pour ce compte"
        }));
    }

    let challenge = crate::webauthn_manager::generate_challenge();

    if let Err(e) = crate::webauthn_manager::store_challenge(&conn, &challenge, uq_number, "login") {
        return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": e
        }));
    }

    HttpResponse::Ok().json(json!({
        "status": "success",
        "challenge": challenge,
        "timeout": 60000,
        "userVerification": "required"
    }))
}

