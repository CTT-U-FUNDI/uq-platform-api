/// GET /api/fxb/stats
/// Retourne les statistiques de traÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â§abilitÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©
pub async fn fixorb_tracer_stats() -> HttpResponse {
    let db_path = "data/users/uq_00000001.db";
    let conn = match rusqlite::Connection::open(db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("DB: {}", e)
        })),
    };

    let _ = crate::fxb_tracer::init_fxb_origins_table(&conn);

    // Compter les entrÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©es
    let total: i64 = conn.query_row(
        "SELECT COUNT(*) FROM fxb_origins", [], |row| row.get(0)
    ).unwrap_or(0);

    // Total distribuÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©
    let total_amount: i64 = conn.query_row(
        "SELECT COALESCE(SUM(amount_points), 0) FROM fxb_origins", [], |row| row.get(0)
    ).unwrap_or(0);

    // DerniÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¨re ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©mission
    let last = conn.query_row(
        "SELECT trace_key, timestamp, recipient_uq, amount_points
         FROM fxb_origins ORDER BY timestamp DESC LIMIT 1",
        [],
        |row| Ok(json!({
            "trace_key": row.get::<_, String>(0)?,
            "timestamp": row.get::<_, i64>(1)?,
            "recipient": row.get::<_, String>(2)?,
            "amount": row.get::<_, i64>(3)?,
        }))
    ).unwrap_or(json!(null));

    HttpResponse::Ok().json(json!({
        "status": "success",
        "stats": {
            "total_fxb_traced": total,
            "total_amount_points": total_amount,
            "total_amount_fxb": total_amount as f64 / 100.0,
            "last_emission": last
        }
    }))
}
