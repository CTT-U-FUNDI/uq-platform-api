fn get_public_identity(uq_number: &str) -> (String, String) {
    // Retourne (public_uq, display_name)
    // Cherche dans la DB du user ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ uq_aliases
    let db_path = format!("data/users/{}.db", uq_number.replace("-", "_").to_lowercase());
    
    // Valeur par dÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©faut : retourner le UQ et un nom vide
    let mut public_uq = uq_number.to_string();
    let mut display_name = String::new();
    
    if !std::path::Path::new(&db_path).exists() {
        return (public_uq, display_name);
    }
    
    if let Ok(conn) = rusqlite::Connection::open(&db_path) {
        // Chercher dans uq_aliases
        let result: Result<(String, String), _> = conn.query_row(
            "SELECT public_uq, display_name FROM uq_aliases WHERE real_uq = ?1 AND active = 1",
            rusqlite::params![uq_number],
            |row| Ok((row.get(0)?, row.get(1)?)),
        );
        
        if let Ok((pub_uq, disp)) = result {
            if !pub_uq.is_empty() {
                public_uq = pub_uq;
            }
            if !disp.is_empty() {
                display_name = disp;
            }
        }
    }
    
    (public_uq, display_name)
}
