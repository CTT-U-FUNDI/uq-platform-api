        let ts: i64 = row.get(4)?;
        Ok(json!({
            "type": row.get::<_, String>(0)?,
            "amount": row.get::<_, i64>(1)?,
            "fee": row.get::<_, i64>(2)?,
            "counterparty": row.get::<_, String>(3)?,
            "timestamp": ts,
            "date": chrono::DateTime::from_timestamp(ts, 0)
                .map(|d| d.format("%Y-%m-%d %H:%M").to_string())
                .unwrap_or_default()
        }))
    });
    
    let mut history = Vec::new();
    if let Ok(r) = rows {
        for row in r {
            if let Ok(v) = row {
                history.push(v);
            }
        }
    }
    
    let total_in: i64 = history.iter()
        .filter(|h| h["type"] == "receive")
        .map(|h| h["amount"].as_i64().unwrap_or(0))
        .sum();
    
    let total_out: i64 = history.iter()
        .filter(|h| h["type"] == "send")
        .map(|h| h["amount"].as_i64().unwrap_or(0))
        .sum();
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "account": account_id,
        "total": history.len(),
        "total_in": total_in,
        "total_out": total_out,
        "net": total_in - total_out,
        "history": history
    }))
}

/// GET /api/price/history/all ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â Historique complet (or + btc + fxb)
pub async fn price_history_all() -> HttpResponse {
    let btc_history = fetch_btc_history_24h().await;
    let gold_history = fetch_gold_history_24h();
    
    let btc_first = btc_history.first().copied().unwrap_or(0.0);
    let btc_last = btc_history.last().copied().unwrap_or(0.0);
    let btc_change = if btc_first > 0.0 { ((btc_last - btc_first) / btc_first) * 100.0 } else { 0.0 };
    
    let gold_first = gold_history.first().copied().unwrap_or(0.0);
    let gold_last = gold_history.last().copied().unwrap_or(0.0);
    let gold_change = if gold_first > 0.0 { ((gold_last - gold_first) / gold_first) * 100.0 } else { 0.0 };
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "period": "24h",
        "btc": {
            "data": btc_history,
            "change_pct": btc_change,
            "source": "coingecko"
        },
        "gold": {
            "data": gold_history,
            "change_pct": gold_change,
            "source": "internal_oracle"
        }
    }))
}

