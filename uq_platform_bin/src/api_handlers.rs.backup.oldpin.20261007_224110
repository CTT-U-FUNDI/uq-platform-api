/// Route : /api/price/all ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â Or + USD + BTC
pub async fn price_all() -> HttpResponse {
    // Cache en mÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©moire (60s)
    static PRICE_CACHE: std::sync::OnceLock<std::sync::Mutex<(f64, f64, i64)>> = std::sync::OnceLock::new();
    
    let now = chrono::Utc::now().timestamp();
    let cache = PRICE_CACHE.get_or_init(|| std::sync::Mutex::new((0.0, 0.0, 0)));
    
    let (btc_usd, gold_usd) = {
        let c = cache.lock().unwrap();
        if now - c.2 < 60 && c.0 > 0.0 && c.1 > 0.0 {
            (c.0, c.1)
        } else {
            drop(c);
            
            // fetch_btc_price() retourne f64 directement
            // timeout() retourne Result<f64, Elapsed>
            let btc = match tokio::time::timeout(
                std::time::Duration::from_secs(10),
                fetch_btc_price()
            ).await {
                Ok(p) if p > 0.0 => p,
                _ => 95000.0,
            };
            
            // fetch_gold_price() retourne f64 directement
            let gold = match tokio::time::timeout(
                std::time::Duration::from_secs(5),
                fetch_gold_price()
            ).await {
                Ok(p) if p > 0.0 => p,
                _ => 2000.0,
            };
            
            if let Ok(mut c) = cache.lock() {
                *c = (btc, gold, now);
            }
            
            (btc, gold)
        }
    };
    
    let fxb_usd = gold_usd / 2000.0;
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "prices": {
            "gold_usd_per_ounce": gold_usd,
            "btc_usd": btc_usd,
            "fxb_usd": fxb_usd,
            "fxb_btc": if btc_usd > 0.0 { fxb_usd / btc_usd } else { 0.0 }
        },
        "source": {
            "gold": "internal_oracle",
            "btc": "coingecko"
        },
        "updated_at": now
