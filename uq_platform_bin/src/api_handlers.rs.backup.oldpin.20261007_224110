pub async fn fixorb_receive(
    path: web::Path<String>,
) -> HttpResponse {
    let account_id = path.into_inner();
    let db_path = format!("data/users/{}.db", account_id.replace("-", "_").to_lowercase());
    
    if !std::path::Path::new(&db_path).exists() {
        return HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": format!("Compte introuvable: {}", account_id)
        }));
    }
    
    let conn = match rusqlite::Connection::open(&db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur: {}", e)
        })),
    };
    
    let mut stmt = match conn.prepare(
        "SELECT amount, counterparty, created_at FROM transactions WHERE tx_type = 'receive' ORDER BY created_at DESC LIMIT 10"
    ) {
        Ok(s) => s,
        Err(_) => return HttpResponse::Ok().json(json!({
            "status": "success",
            "account": account_id,
            "recent_receives": []
        })),
    };
    
    let rows = stmt.query_map([], |row| {
        Ok(json!({
            "amount": row.get::<_, i64>(0)?,
            "from": row.get::<_, String>(1)?,
            "timestamp": row.get::<_, i64>(2)?
        }))
    });
    
    let mut receives = Vec::new();
    if let Ok(r) = rows {
        for row in r {
            if let Ok(v) = row { receives.push(v); }
        }
    }
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "account": account_id,
        "recent_receives": receives
    }))
}

pub async fn fixorb_balance(
