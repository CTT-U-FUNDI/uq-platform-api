pub async fn bubble_create(
    state: web::Data<Arc<GlobalState>>,
    body: web::Json<serde_json::Value>,
) -> HttpResponse {
    let owner = body.get("owner").and_then(|v| v.as_str()).unwrap_or("UQ-00000001");
    let amount = body.get("amount_micro").and_then(|v| v.as_u64()).unwrap_or(0);
    
    // Creer une bulle dans BubbleRegistry
    let mut registry = state.bubble_registry.lock().unwrap();
    
    let owner_bytes = {
        let mut addr = [0u8; 32];
        let bytes = owner.as_bytes();
        for i in 0..32 {
            if i < bytes.len() {
                addr[i] = bytes[i];
            }
        }
        addr
    };
    
    match registry.create_bubble(
        owner_bytes,
        owner_bytes,
        amount,
        Vec::new(),
        |data| {
            use sha2::{Sha256, Digest};
            let mut hasher = Sha256::new();
            hasher.update(data);
            hasher.finalize().to_vec()
        },
    ) {
        Ok(bubble) => HttpResponse::Ok().json(json!({
            "status": "success",
            "bubble_created": true,
            "bubble_id": format!("{:?}", &bubble.id[..8]),
            "amount_micro": amount
        })),
        Err(e) => HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": format!("{}", e)
        })),
    }
