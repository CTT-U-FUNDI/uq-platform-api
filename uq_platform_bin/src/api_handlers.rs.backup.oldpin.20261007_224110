pub async fn escrow_create(body: web::Json<serde_json::Value>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    let buyer = body.get("buyer").and_then(|v| v.as_str()).unwrap_or("");
    let seller = body.get("seller").and_then(|v| v.as_str()).unwrap_or("escrow");
    let amount = body.get("amount_fxb").and_then(|v| v.as_u64()).unwrap_or(0);
    let desc = format!("Escrow {} -> {} : {} FXB", buyer, seller, amount);
    db.publish_offer(seller, &desc, amount.max(1), 1);
    let escrow_id = format!("esc_{}", chrono::Utc::now().timestamp());
    HttpResponse::Ok().json(json!({"status":"success","escrow_created":true,"escrow_id": escrow_id}))
}
