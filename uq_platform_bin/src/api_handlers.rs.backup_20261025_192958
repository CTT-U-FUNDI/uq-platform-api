pub async fn distribution_claim(body: web::Json<serde_json::Value>) -> HttpResponse {
    use crate::fixorb_distribution::FixorbDistribution;
    use rusqlite::Connection;

    // 1. Recuperer le UQ du profil 2 (depuis le body)
    let uq_profil2 = body.get("uq_profil2")
        .and_then(|v| v.as_str())
        .unwrap_or("UQ-230354360");

    // 2. Ouvrir la DB pour verifier le solde multi_wallets
    let conn = match Connection::open("uq_index.db") {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": e.to_string()
        })),
    };

    let solde_avant: f64 = conn.query_row(
        "SELECT COALESCE(balance, 0.0) FROM multi_wallets WHERE uq_number = ?1 AND currency = 'FXB'",
        rusqlite::params![uq_profil2],
        |row| row.get(0),
    ).unwrap_or(0.0);

    // 3. Verifier le seuil 50% (150 000 FXB)
    let seuil_max = 150_000.0;
    if solde_avant >= seuil_max {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": format!("Solde {} >= seuil {} - Reclamation interdite", solde_avant, seuil_max)
        }));
    }

    // 4. Reclamation treasury -> dev_profile
    let dist = FixorbDistribution::new("UQ-00000001");
    let montant_reclame = match dist.profile2_claim_from_profile1() {
        Ok(_new_balance) => 300_000.0,
        Err(e) => return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": format!("{}", e)
        })),
    };

    // 5. Crediter multi_wallets[UQ-230354360].FXB
    let now = chrono::Utc::now().timestamp();
    let _ = conn.execute(
        "INSERT INTO multi_wallets (uq_number, currency, balance, updated_at)
         VALUES (?1, 'FXB', ?2, ?3)
         ON CONFLICT(uq_number, currency) DO UPDATE SET balance = balance + ?2, updated_at = ?3",
        rusqlite::params![uq_profil2, montant_reclame, now],
    );

    // 6. Recuperer le nouveau solde
    let solde_apres: f64 = conn.query_row(
        "SELECT COALESCE(balance, 0.0) FROM multi_wallets WHERE uq_number = ?1 AND currency = 'FXB'",
        rusqlite::params![uq_profil2],
        |row| row.get(0),
    ).unwrap_or(0.0);

    eprintln!("[CLAIM] {} reclame {} FXB ({} -> {})", uq_profil2, montant_reclame, solde_avant, solde_apres);

    HttpResponse::Ok().json(json!({
        "status": "success",
        "uq_profil2": uq_profil2,
        "montant_reclame": montant_reclame,
        "solde_avant": solde_avant,
        "solde_apres": solde_apres
    }))
}

