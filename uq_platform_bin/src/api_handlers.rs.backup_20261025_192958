fn validate_transfer_amounts(amount_points: u64, fee_points: u64) -> Result<(u64, u64), HttpResponse> {
    if amount_points == 0 {
        return Err(HttpResponse::BadRequest().json(json!({
            "status": "error",
            "code": "INVALID_AMOUNT",
            "message": "Le montant doit Ãªtre > 0"
        })));
    }

    if fee_points > amount_points / 100 {
        return Err(HttpResponse::BadRequest().json(json!({
            "status": "error",
            "code": "INVALID_FEE",
            "message": "Les frais ne peuvent pas dÃ©passer 1% du montant"
        })));
    }

    let total_cost = amount_points.checked_add(fee_points).ok_or_else(|| {
        HttpResponse::BadRequest().json(json!({
            "status": "error",
            "code": "OVERFLOW",
            "message": "Montant total trop Ã©levÃ©"
        }))
    })?;

    if total_cost > i64::MAX as u64 {
        return Err(HttpResponse::BadRequest().json(json!({
            "status": "error",
            "code": "AMOUNT_TOO_HIGH",
            "message": "Montant dÃ©passe la limite autorisÃ©e"
        })));
    }

    Ok((amount_points, fee_points))
}

#[derive(Debug, PartialEq)]
enum ConvertedTransferAmountError {
    Invalid,
    Precision,
    TooLarge,
}

fn calculate_converted_transfer_amount(
    amount: f64,
) -> Result<i64, ConvertedTransferAmountError> {
    if !amount.is_finite() || amount <= 0.0 {
        return Err(ConvertedTransferAmountError::Invalid);
    }

    let amount_minor = amount * 100.0;
    if !amount_minor.is_finite() || amount_minor >= i64::MAX as f64 {
        return Err(ConvertedTransferAmountError::TooLarge);
    }
    let rounded_minor = amount_minor.round();
    if rounded_minor < 1.0 || (amount_minor - rounded_minor).abs() > 0.000001 {
        return Err(ConvertedTransferAmountError::Precision);
    }

    // Les transferts de devises dÃ©jÃ  converties sont sans frais.
    Ok(rounded_minor as i64)
}

fn calculate_currency_to_borb_points(
    amount: f64,
    borb_per_currency: f64,
) -> Result<(i64, i64), ConvertedTransferAmountError> {
    if !borb_per_currency.is_finite() || borb_per_currency <= 0.0 {
        return Err(ConvertedTransferAmountError::Invalid);
    }

    let amount_minor = calculate_converted_transfer_amount(amount)?;
    let points = amount_minor as f64 * borb_per_currency;
    if !points.is_finite() || points >= i64::MAX as f64 {
        return Err(ConvertedTransferAmountError::TooLarge);
    }

    let rounded_points = points.round();
    if rounded_points < 1.0 || (points - rounded_points).abs() > 0.000001 {
        return Err(ConvertedTransferAmountError::Precision);
    }

    Ok((amount_minor, rounded_points as i64))
}

fn settle_currency_to_borb(
    tx: &rusqlite::Transaction<'_>,
    uq: &str,
    currency: &str,
    amount_minor: i64,
    points: i64,
    updated_at: i64,
) -> Result<bool, rusqlite::Error> {
    let amount = amount_minor as f64 / 100.0;
    let debit = tx.execute(
        "UPDATE multi_wallets
         SET balance = balance - ?1, updated_at = ?2
         WHERE uq_number = ?3 AND currency = ?4 AND balance >= ?1",
        rusqlite::params![amount, updated_at, uq, currency],
    )?;
    if debit != 1 {
        return Ok(false);
    }

    let credit = tx.execute(
        "UPDATE user_account.balance
         SET points = points + ?1
         WHERE id = 1 AND points <= ?2",
        rusqlite::params![points, i64::MAX - points],
    )?;
    Ok(credit == 1)
}

fn settle_converted_transfer(
    tx: &rusqlite::Transaction<'_>,
    sender: &str,
    recipient: &str,
    currency: &str,
    amount_minor: i64,
    memo: &str,
    transfer_id: &str,
    created_at: i64,
) -> Result<bool, rusqlite::Error> {
    let amount = amount_minor as f64 / 100.0;
    
    // Points BORB correspondants (1 USD = 100 points)
    let amount_points = (amount * 100.0) as i64;

    // ═══════════════════════════════════════════════════════════
    // 1. DÉBITER LE BORB DU SENDER (le vrai argent)
    // ═══════════════════════════════════════════════════════════
    let sender_db_path = format!("data/users/{}.db", sender.replace("-", "_").to_lowercase());
    let recipient_db_path = format!("data/users/{}.db", recipient.replace("-", "_").to_lowercase());
    
    // Ouvrir la base du sender pour débiter son BORB
    if let Ok(sender_conn) = rusqlite::Connection::open(&sender_db_path) {
        let sender_debit = sender_conn.execute(
            "UPDATE balance SET points = points - ?1, updated_at = ?2 WHERE id = 1 AND points >= ?3",
            rusqlite::params![amount_points, created_at, amount_points],
        )?;
        if sender_debit != 1 {
            return Ok(false); // Solde BORB insuffisant
        }
    } else {
        return Ok(false); // Base sender introuvable
    }

    // ═══════════════════════════════════════════════════════════
    // 2. DÉBITER L'OMBRE (multi_wallets) DU SENDER
    // ═══════════════════════════════════════════════════════════
    let debit = tx.execute(
        "UPDATE multi_wallets
         SET balance = balance - ?1, updated_at = ?2
         WHERE uq_number = ?3 AND currency = ?4 AND balance >= ?5",
        rusqlite::params![amount, created_at, sender, currency, amount],
    )?;
    if debit != 1 {
        return Ok(false); // Solde devise insuffisant
    }

    // ═══════════════════════════════════════════════════════════
    // 3. CRÉDITER LE BORB DU RECIPIENT (le vrai argent)
    // ═══════════════════════════════════════════════════════════
    if let Ok(recipient_conn) = rusqlite::Connection::open(&recipient_db_path) {
        recipient_conn.execute(
            "UPDATE balance SET points = points + ?1, updated_at = ?2 WHERE id = 1",
            rusqlite::params![amount_points, created_at],
        )?;
    }

    // ═══════════════════════════════════════════════════════════
    // 4. CRÉDITER L'OMBRE (multi_wallets) DU RECIPIENT
    // ═══════════════════════════════════════════════════════════
    tx.execute(
        "INSERT INTO multi_wallets (uq_number, currency, balance, updated_at)
         VALUES (?1, ?2, ?3, ?4)
         ON CONFLICT(uq_number, currency)
         DO UPDATE SET balance = multi_wallets.balance + excluded.balance, updated_at = excluded.updated_at",
        rusqlite::params![recipient, currency, amount, created_at],
    )?;

    // ═══════════════════════════════════════════════════════════
    // 5. ENREGISTRER LA TRANSACTION
    // ═══════════════════════════════════════════════════════════
    tx.execute(
        "INSERT INTO wallet_transfers
            (transfer_id, sender_uq, recipient_uq, currency, amount, fee, memo, created_at)
         VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)",
        rusqlite::params![transfer_id, sender, recipient, currency, amount, 0.0, memo, created_at],
    )?;

    Ok(true)
}

async fn transfer_converted_currency(
    sender: &str,
    recipient: &str,
    currency: &str,
    amount_currency: Option<f64>,
    amount_points: u64,
    memo: &str,
) -> HttpResponse {
    use rusqlite::Connection;

    const FIAT_CURRENCIES: &[&str] = &[
        "CDF", "XAF", "XOF", "NGN", "KES", "ZAR", "MAD", "GHS", "UGX", "TZS",
        "EGP", "RWF", "BIF", "MZN", "AOA", "ETB", "USD", "EUR", "GBP", "CHF",
        "JPY", "CNY", "CAD", "AUD", "INR", "BRL", "MXN", "SEK", "NOK", "DKK",
        "PLN", "TRY",
    ];

    let code = currency.trim().to_uppercase();
    if !FIAT_CURRENCIES.contains(&code.as_str()) {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "code": "UNSUPPORTED_TRANSFER_CURRENCY",
            "message": "Seules les devises fiat converties peuvent Ãªtre transfÃ©rÃ©es."
        }));
    }
    if sender.eq_ignore_ascii_case(recipient) {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "code": "SAME_ACCOUNT",
            "message": "L'expÃ©diteur et le destinataire doivent Ãªtre diffÃ©rents."
        }));
    }

    let taux = taux_live_fxb().await;
    let Some(taux_fxb) = taux.get(&code).copied().filter(|rate| rate.is_finite() && *rate > 0.0) else {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "code": "MISSING_CURRENCY_RATE",
            "message": "Le taux de conversion de cette devise est indisponible."
        }));
    };

    let amount = match amount_currency {
        Some(value) => value,
        None => amount_points as f64 / 100.0 / taux_fxb,
    };
    let amount_minor = match calculate_converted_transfer_amount(amount) {
        Ok(amount_minor) => amount_minor,
        Err(ConvertedTransferAmountError::Invalid) => {
            return HttpResponse::BadRequest().json(json!({
                "status": "error",
                "code": "INVALID_AMOUNT",
                "message": "Montant de transfert invalide."
            }))
        }
        Err(ConvertedTransferAmountError::Precision) => {
            return HttpResponse::BadRequest().json(json!({
                "status": "error",
                "code": "INVALID_PRECISION",
                "message": "Le montant doit Ãªtre au centiÃ¨me prÃ¨s."
            }))
        }
        Err(ConvertedTransferAmountError::TooLarge) => {
            return HttpResponse::BadRequest().json(json!({
                "status": "error",
                "code": "AMOUNT_TOO_HIGH",
                "message": "Montant de transfert trop Ã©levÃ©."
            }))
        }
    };
    let amount = amount_minor as f64 / 100.0;
    let now = chrono::Utc::now().timestamp();
    let transfer_id = format!("wtx_{}", uuid::Uuid::new_v4());

    let conn = match Connection::open("uq_index.db") {
        Ok(conn) => conn,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Base des portefeuilles indisponible: {}", e)
        })),
    };
    if let Err(e) = conn.execute_batch(
        "CREATE TABLE IF NOT EXISTS wallet_transfers (
            transfer_id TEXT PRIMARY KEY,
            sender_uq TEXT NOT NULL,
            recipient_uq TEXT NOT NULL,
            currency TEXT NOT NULL,
            amount REAL NOT NULL,
            fee REAL NOT NULL,
            memo TEXT NOT NULL,
            created_at INTEGER NOT NULL
        );
        CREATE INDEX IF NOT EXISTS idx_wallet_transfers_sender
            ON wallet_transfers(sender_uq, created_at);
        CREATE INDEX IF NOT EXISTS idx_wallet_transfers_recipient
            ON wallet_transfers(recipient_uq, created_at);",
    ) {
        return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Initialisation de l'historique impossible: {}", e)
        }));
    }

    let mut conn = conn;
    let tx = match conn.transaction_with_behavior(rusqlite::TransactionBehavior::Immediate) {
        Ok(tx) => tx,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Transaction impossible: {}", e)
        })),
    };

    let settled = match settle_converted_transfer(
        &tx,
        sender,
        recipient,
        &code,
        amount_minor,
        memo,
        &transfer_id,
        now,
    ) {
        Ok(settled) => settled,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("RÃ¨glement du transfert impossible: {}", e)
        })),
    };
    if !settled {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "code": "INSUFFICIENT_CURRENCY_BALANCE",
            "currency": code,
            "message": format!("Solde {} insuffisant pour le montant et les frais.", code)
        }));
    }

    if let Err(e) = tx.commit() {
        return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Validation du transfert impossible: {}", e)
        }));
    }

    HttpResponse::Ok().json(json!({
        "status": "success",
        "transfer_id": transfer_id,
        "currency": code,
        "amount": amount,
        "fee": 0.0,
        "recipient": crate::uq_public_alias::get_public_display(recipient),
        "amount_fxb_equivalent": amount * taux_fxb,
    }))
}


