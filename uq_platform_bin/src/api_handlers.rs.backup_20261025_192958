/// Charge le nombre d'unitÃ©s dÃ©bloquÃ©es (depuis data/subunits.json)
fn load_unlocked_count() -> usize {
    let path = "data/subunits.json";
    if let Ok(content) = std::fs::read_to_string(path) {
        if let Ok(json) = serde_json::from_str::<serde_json::Value>(&content) {
            return json.get("unlocked_count")
                .and_then(|v| v.as_u64())
                .unwrap_or(6) as usize;
        }
    }
    6  // Par dÃ©faut : 6 unitÃ©s de base
}

/// Sauvegarde le nombre d'unitÃ©s dÃ©bloquÃ©es
fn save_unlocked_count(count: usize) {
    let path = "data/subunits.json";
    let json = json!({
        "unlocked_count": count,
        "updated_at": chrono::Utc::now().timestamp()
    });
    let _ = std::fs::write(path, json.to_string());
}

