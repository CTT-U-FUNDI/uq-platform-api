/// POST /api/ubi/claim â€” crÃ©dite rÃ©ellement le portefeuille de l'utilisateur.
///
/// Avant ce correctif la route ne crÃ©ditait RIEN (elle se contentait
/// d'appeler un pool en mÃ©moire) : un compte neuf restait Ã  0 FXB et ne
/// pouvait donc jamais effectuer de transaction.
///
/// Ici :
///   1. authentification + vÃ©rification que le compte est bien celui du token
///   2. cooldown de 24 h (table ubi_claims du compte)
///   3. dÃ©bit de l'enveloppe UBI du BlockOrb + crÃ©dit du portefeuille
///      (l'invariant des 40 Md FXB est vÃ©rifiÃ©)
///   4. Ã©criture dans balance.points, transactions, my_fixorb_units, wallet
pub async fn ubi_claim(
    req: actix_web::HttpRequest,
    body: web::Json<serde_json::Value>,
) -> HttpResponse {
    // â”€â”€â”€ 1. Compte ciblÃ© â”€â”€â”€
    let account = body
        .get("account")
        .and_then(|v| v.as_str())
        .or_else(|| body.get("uq_number").and_then(|v| v.as_str()))
        .unwrap_or("")
        .trim()
        .to_string();

    if account.is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "account (ou uq_number) requis"
        }));
    }

    // â”€â”€â”€ 2. Authentification : on ne crÃ©dite que son propre compte â”€â”€â”€
    let claims = match crate::auth::AuthManager::require_role(&req, &["user", "admin", "guardian", "owner"]) {
        Ok(c) => c,
        Err(resp) => return resp,
    };

    let est_admin = claims.role == "admin" || claims.role == "owner";
    if !est_admin && !claims.sub.eq_ignore_ascii_case(&account) {
        return HttpResponse::Forbidden().json(json!({
            "status": "error",
            "code": "ACCOUNT_MISMATCH",
            "message": "Tu ne peux reclamer l'UBI que pour ton propre compte"
        }));
    }

    let db_path = format!("data/users/{}.db", account.replace("-", "_").to_lowercase());
    if !std::path::Path::new(&db_path).exists() {
        return HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": format!("Compte introuvable: {}", account)
        }));
    }

    let conn = match rusqlite::Connection::open(&db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur DB: {}", e)
        })),
    };

    let _ = conn.execute(ubi_table_sql(), []);

    let now = chrono::Utc::now().timestamp();

    // â”€â”€â”€ 3. Cooldown 24 h â”€â”€â”€
    let derniere: Option<i64> = conn
        .query_row("SELECT MAX(claimed_at) FROM ubi_claims", [], |row| row.get(0))
        .ok()
        .flatten();

    if let Some(derniere) = derniere {
        let restant = UBI_COOLDOWN_SECS - (now - derniere);
        if restant > 0 {
            return HttpResponse::BadRequest().json(json!({
                "status": "error",
                "code": "COOLDOWN",
                "seconds_remaining": restant,
                "next_claim_at": derniere + UBI_COOLDOWN_SECS,
                "message": format!("UBI deja reclame. Prochaine reclamation dans {} h {} min.",
                    restant / 3600, (restant % 3600) / 60)
            }));
        }
    }

    // â”€â”€â”€ 4. Montant + enveloppe BlockOrb â”€â”€â”€
    let points = ubi_daily_points();
    let montant_femto = (points as u128) * crate::montant::FEMTO_PAR_FXB / 100;

    let mut orb = crate::persistence::load_global_orb();

    if orb.ubi_enveloppe < montant_femto {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "Enveloppe UBI epuisee."
        }));
    }

    if !orb.comptes.contains_key(&account) {
        return HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": format!("Portefeuille {} absent du BlockOrb", account)
        }));
    }

    let enveloppe_avant = orb.ubi_enveloppe;
    let solde_avant = orb.comptes.get(&account).map(|p| p.solde).unwrap_or(0);

    // DÃ©bit enveloppe / crÃ©dit portefeuille (transfert interne, invariant prÃ©servÃ©)
    orb.ubi_enveloppe -= montant_femto;
    if let Some(pf) = orb.comptes.get_mut(&account) {
        pf.solde = pf.solde.saturating_add(montant_femto);
    }

    if !orb.verifier() {
        return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": "Invariant casse â€” UBI annule (aucun debit effectue)"
        }));
    }

    if let Err(e) = crate::persistence::save_global_orb(&orb) {
        return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur sauvegarde BlockOrb: {}", e)
        }));
    }

    // â”€â”€â”€ 5. Ã‰criture SQLite (source de vÃ©ritÃ© des soldes dÃ©pensables) â”€â”€â”€
    let tx_result = (|| -> Result<i64, String> {
        conn.execute("BEGIN IMMEDIATE", []).map_err(|e| e.to_string())?;

        conn.execute(
            "UPDATE balance SET points = points + ?1, updated_at = ?2 WHERE id = 1",
            rusqlite::params![points, now],
        ).map_err(|e| e.to_string())?;

        let nouveau_solde: i64 = conn
            .query_row("SELECT points FROM balance WHERE id = 1", [], |r| r.get(0))
            .unwrap_or(0);

        // Sous-unitÃ©s alignÃ©es sur le solde
        conn.execute(
            "UPDATE my_fixorb_units SET balance = ?1, updated_at = ?2 WHERE unit = 'FXB'",
            rusqlite::params![nouveau_solde / 100, now],
        ).map_err(|e| e.to_string())?;

        // Table wallet (historique) remise Ã  jour
        conn.execute(
            "UPDATE wallet SET balance_fxb = ?1, balance_points = ?2,
                    total_received = COALESCE(total_received, 0) + ?3, last_updated = ?4
             WHERE id = 1",
            rusqlite::params![nouveau_solde as f64 / 100.0, nouveau_solde, points, now],
        ).map_err(|e| e.to_string())?;

        // ðŸ“œ Historique LOCAL : fxb_id + prev_hash + block_number
        let reference = format!("UQ-UBI-{}", now);
        let fxb_id_ubi = crate::blockchain_lib::hash_transaction(
            "UQ-TRESOR-UBI",
            &account,
            points as u64,
            0,
            now,
        );
        let prev_hash_ubi = crate::local_history::dernier_fxb_id(&conn);
        let block_number_ubi = crate::persistence::load_global_orb().block_number as i64;

        conn.execute(
            "INSERT INTO transactions (tx_type, amount, fee, counterparty, memo, created_at,
                                       sender_uq, recipient_uq, amount_fxb, amount_usd, taux_usd,
                                       status, reference, fxb_id, prev_hash, block_number)
             VALUES ('ubi', ?1, 0, 'UQ-TRESOR-UBI', ?2, ?3, 'UQ-TRESOR-UBI', ?4, ?5, ?5, '1.0', 'success', ?6, ?7, ?8, ?9)",
            rusqlite::params![
                points,
                reference,
                now,
                account,
                points as f64 / 100.0,
                reference,
                fxb_id_ubi,
                prev_hash_ubi,
                block_number_ubi
            ],
        ).map_err(|e| e.to_string())?;

        conn.execute(
            "INSERT INTO ubi_claims (amount, claimed_at) VALUES (?1, ?2)",
            rusqlite::params![points, now],
        ).map_err(|e| e.to_string())?;

        conn.execute("COMMIT", []).map_err(|e| e.to_string())?;
        Ok(nouveau_solde)
    })();

    match tx_result {
        Ok(nouveau_solde) => {
            // ðŸ”’ Le scellÃ© doit suivre TOUTE Ã©criture dans l'historique,
            //    sinon /api/history/{uq}/verify signalerait Ã  tort une
            //    falsification (bug detecte par verify_history.ps1).
            if let Err(e) = crate::local_history::sceller(&conn, &account) {
                eprintln!("âš ï¸  Scelle historique UBI {} non ecrit : {}", account, e);
            }

            eprintln!(
                "ðŸŽ UBI {} : +{} points ({} FXB) | solde {} points | enveloppe {} -> {}",
                account, points, points as f64 / 100.0, nouveau_solde, enveloppe_avant, orb.ubi_enveloppe
            );

            HttpResponse::Ok().json(json!({
                "status": "success",
                "amount_points": points,
                "amount_fxb": points as f64 / 100.0,
                "balance_points": nouveau_solde,
                "balance_fxb": nouveau_solde as f64 / 100.0,
                "next_claim_at": now + UBI_COOLDOWN_SECS,
                "enveloppe_ubi_restante_femto": orb.ubi_enveloppe.to_string(),
                "solde_blockorb_avant": solde_avant.to_string(),
                "message": "UBI reclame et credite"
            }))
        }
        Err(e) => {
            // Rollback BlockOrb pour rester cohÃ©rent avec SQLite
            orb.ubi_enveloppe = enveloppe_avant;
            if let Some(pf) = orb.comptes.get_mut(&account) {
                pf.solde = solde_avant;
            }
            let _ = crate::persistence::save_global_orb(&orb);
            let _ = conn.execute("ROLLBACK", []);

            HttpResponse::InternalServerError().json(json!({
                "status": "error",
                "message": format!("Erreur credit UBI: {}", e)
            }))
        }
    }
}

/// GET /api/ubi/check/{uq} â€” statut rÃ©el de rÃ©clamation
pub async fn ubi_check(path: web::Path<String>) -> HttpResponse {
    let account = path.into_inner();
    let db_path = format!("data/users/{}.db", account.replace("-", "_").to_lowercase());

    if !std::path::Path::new(&db_path).exists() {
        return HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": format!("Compte introuvable: {}", account)
        }));
    }

    let conn = match rusqlite::Connection::open(&db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur DB: {}", e)
        })),
    };

    let _ = conn.execute(ubi_table_sql(), []);

    let derniere: Option<i64> = conn
        .query_row("SELECT MAX(claimed_at) FROM ubi_claims", [], |row| row.get(0))
        .ok()
        .flatten();

    let now = chrono::Utc::now().timestamp();
    let next_claim_at = derniere.map(|d| d + UBI_COOLDOWN_SECS).unwrap_or(now);
    let eligible = next_claim_at <= now;

    HttpResponse::Ok().json(json!({
        "status": "success",
        "account": account,
        "eligible": eligible,
        "last_claim_at": derniere,
        "next_claim_at": next_claim_at,
        "daily_points": ubi_daily_points(),
        "seconds_remaining": if eligible { 0 } else { next_claim_at - now }
    }))
}

