pub async fn fixorb_transactions(
    req: actix_web::HttpRequest,
    path: web::Path<String>,
) -> HttpResponse {
    // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    // SÃ‰CURITÃ‰ : VÃ©rifier que l'utilisateur accÃ¨de Ã  SES transactions
    // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    use crate::auth::AuthManager;
    
    let claims = match AuthManager::require_role(&req, &["user", "admin", "guardian"]) {
        Ok(c) => c,
        Err(resp) => return resp,
    };
    
    let account_id = path.into_inner();
    
    // Un user ne peut voir QUE ses propres transactions
    // L'owner (UQ-00000001) peut voir TOUT
    let is_owner = claims.sub == "UQ-00000001";
    let is_self = claims.sub == account_id;
    
    if !is_owner && !is_self {
        return HttpResponse::Forbidden().json(json!({
            "status": "error",
            "message": "AccÃ¨s refusÃ© â€” tu ne peux voir que TES transactions"
        }));
    }
    
    let db_path = format!("data/users/{}.db", account_id.replace("-", "_").to_lowercase());
    
    if !std::path::Path::new(&db_path).exists() {
        return HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": format!("Compte introuvable: {}", account_id)
        }));
    }
    
    let conn = match rusqlite::Connection::open(&db_path) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur: {}", e)
        })),
    };
    
    // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    // ðŸ§¬ ALIGNEMENT DU SCHÃ‰MA AVANT LECTURE (cause du bug Â« historique vide Â»)
    // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    // La requÃªte ci-dessous lit fxb_id / prev_hash / block_number.
    // Les comptes crÃ©Ã©s avant la migration v4 ne possÃ¨dent PAS ces colonnes :
    // `prepare()` Ã©chouait alors et le handler renvoyait Â« transactions: [] Â»
    // â†’ l'interface affichait Â« Aucune transaction Â» alors que la table en
    // contenait (8 lignes chez l'owner).
    if let Err(e) = crate::db::ensure_transactions_columns(&conn) {
        eprintln!("âš ï¸  Alignement schÃ©ma transactions (lecture {}): {}", account_id, e);
    }

    let mut stmt = match conn.prepare(
        "SELECT id, tx_type, amount, fee, counterparty, created_at,
                COALESCE(fxb_id,''), COALESCE(prev_hash,''), COALESCE(block_number,0),
                COALESCE(status,'')
         FROM transactions ORDER BY created_at DESC LIMIT 50"
    ) {
        Ok(s) => s,
        // âš ï¸ Ne JAMAIS renvoyer une liste vide en cas d'erreur : c'est ce qui
        //    masquait le problÃ¨me. On remonte l'erreur explicitement.
        Err(e) => {
            eprintln!("âŒ Lecture transactions {} impossible : {}", account_id, e);
            return HttpResponse::InternalServerError().json(json!({
                "status": "error",
                "account": account_id,
                "code": "LECTURE_IMPOSSIBLE",
                "message": format!("Historique illisible : {}", e)
            }));
        }
    };
    
    // Lecture TOLERANTE : les anciennes lignes ont des colonnes NULL
    // (fee, sender_uq, fxb_id...). Avant, `row.get::<_, i64>(3)?` echouait
    // sur fee=NULL et la ligne etait SILENCIEUSEMENT perdue (7/8 affichees).
    let rows = stmt.query_map([], |row| {
        let _cp: String = row.get::<_, Option<String>>(4)?.unwrap_or_default();
        // ðŸ‘¤ Affiche Â« pseudo (Nom) Â» si la base contient encore un UQ
        let _display = crate::uq_public_alias::affichage_public(&_cp);
        Ok(json!({
            "id": row.get::<_, Option<i64>>(0)?.unwrap_or(0),
            "type": row.get::<_, Option<String>>(1)?.unwrap_or_else(|| "inconnu".to_string()),
            "amount": row.get::<_, Option<i64>>(2)?.unwrap_or(0),
            "fee": row.get::<_, Option<i64>>(3)?.unwrap_or(0),
            "counterparty": _display,
            "timestamp": row.get::<_, Option<i64>>(5)?.unwrap_or(0),
            // ðŸ“œ ChaÃ®nage de l'historique local (spÃ©cification)
            "fxb_id": row.get::<_, Option<String>>(6)?.unwrap_or_default(),
            "prev_hash": row.get::<_, Option<String>>(7)?.unwrap_or_default(),
            "block_number": row.get::<_, Option<i64>>(8)?.unwrap_or(0),
            "status": row.get::<_, Option<String>>(9)?.unwrap_or_default()
        }))
    });
    
    let mut transactions = Vec::new();
    if let Ok(r) = rows {
        for row in r {
            if let Ok(v) = row { transactions.push(v); }
        }
    }
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "account": account_id,
        "total": transactions.len(),
        "transactions": transactions
    }))
}

