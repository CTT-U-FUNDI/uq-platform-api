pub async fn fixorb_convert(
    body: web::Json<serde_json::Value>,
) -> HttpResponse {
    let account_id = body.get("account").and_then(|v| v.as_str()).unwrap_or("");
    let from_unit = body.get("from").and_then(|v| v.as_str()).unwrap_or("FXB");
    let to_unit = body.get("to").and_then(|v| v.as_str()).unwrap_or("fxb");
    let amount = body.get("amount").and_then(|v| v.as_i64()).unwrap_or(0);
    
    if account_id.is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "account requis"
        }));
    }
    
    let rates = std::collections::HashMap::from([
        ("FXB", 1i64),
        ("fxb", 100),
        ("mfxb", 10000),
        ("nfxb", 1000000),
        ("pfxb", 100000000),
        ("ffxb", 10000000000),
    ]);
    
    let from_rate = rates.get(from_unit).copied().unwrap_or(1);
    let to_rate = rates.get(to_unit).copied().unwrap_or(1);
    
    let amount_in_points = amount * from_rate;
    let amount_in_to = amount_in_points / to_rate;
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "conversion": {
            "from": from_unit,
            "to": to_unit,
            "amount": amount,
            "result": amount_in_to,
            "rate": format!("1 {} = {} {}", from_unit, to_rate / from_rate, to_unit)
        }
    }))
}

