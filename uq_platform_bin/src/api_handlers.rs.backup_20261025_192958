pub async fn chat_group_create(
    req: HttpRequest,
    body: web::Json<serde_json::Value>,
) -> HttpResponse {
    let claims = match crate::auth_guard::exiger_auth(&req) {
        Ok(claims) => claims,
        Err(response) => return response,
    };
    let name = body.get("name").and_then(|v| v.as_str()).unwrap_or("").trim();
    let description = body.get("description").and_then(|v| v.as_str()).unwrap_or("").trim();
    let group_type = body.get("type").and_then(|v| v.as_str()).unwrap_or("");
    let visibility = body.get("visibility").and_then(|v| v.as_str()).unwrap_or("");
    if name.is_empty() || name.chars().count() > 64 || description.chars().count() > 280 {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "Le nom est obligatoire (64 caractÃ¨res maximum) et la description est limitÃ©e Ã  280 caractÃ¨res."
        }));
    }
    if !["group", "channel"].contains(&group_type)
        || !["public", "private"].contains(&visibility)
    {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "Type de groupe ou visibilitÃ© invalide."
        }));
    }
    let index = uq_index::UqIndex::shared("uq_index.db");
    match index.create_chat_group(name, description, group_type, visibility, &claims.sub) {
        Ok(group) => HttpResponse::Created().json(json!({
            "status": "success",
            "group": group
        })),
        Err(error) => {
            eprintln!("Impossible de crÃ©er un groupe de chat: {}", error);
            HttpResponse::InternalServerError().json(json!({
                "status": "error",
                "message": "Impossible de crÃ©er ce groupe."
            }))
        }
    }
}

