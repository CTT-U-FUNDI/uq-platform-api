pub async fn chat_send(req: actix_web::HttpRequest, body: web::Json<serde_json::Value>) -> HttpResponse {
    // ðŸ” SÃ‰CURITÃ‰ (vague 1) â€” USER : JWT obligatoire
    if let Err(r) = crate::auth_guard::exiger_auth(&req) { return r; }

    let db = Database::shared("uq_platform_db.json");
    let sender = body.get("sender").and_then(|v| v.as_str()).unwrap_or("");
    let recipient = body.get("recipient").and_then(|v| v.as_str()).unwrap_or("");
    let content = body.get("content").and_then(|v| v.as_str()).unwrap_or("");
    if sender.is_empty() || recipient.is_empty() || content.trim().is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "sender, recipient et content requis"
        }));
    }
    let id = db.send_message(sender, recipient, content.trim());
    HttpResponse::Ok().json(json!({"status": "success", "sent": true, "message_id": id}))
}

