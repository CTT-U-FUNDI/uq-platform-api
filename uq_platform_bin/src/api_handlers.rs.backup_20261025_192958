/// CrÃ©e un nouvel Ã©lÃ©ment Zando
pub async fn zando_item_create(
    req: actix_web::HttpRequest,
    body: web::Json<serde_json::Value>,
) -> HttpResponse {
    let claims = match crate::auth_guard::exiger_auth(&req) {
        Ok(claims) => claims,
        Err(response) => return response,
    };
    let db = Database::shared("uq_platform_db.json");

    let item_type = body.get("type").and_then(|v| v.as_str()).unwrap_or("text");
    let media_urls = body.get("media_urls").and_then(|v| v.as_str()).unwrap_or("[]");
    let title = body.get("title").and_then(|v| v.as_str()).unwrap_or("").trim();
    if title.is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "Le titre est obligatoire"
        }));
    }
    let description = body.get("description").and_then(|v| v.as_str()).unwrap_or("");
    let price_fxb = match body.get("price_fxb").and_then(|v| v.as_u64()) {
        Some(price) if price > 0 && price <= i64::MAX as u64 => price,
        _ => {
            return HttpResponse::BadRequest().json(json!({
                "status": "error",
                "message": "Le prix doit Ãªtre un nombre entier positif en FXB"
            }));
        }
    };
    let price_usd = body.get("price_usd").and_then(|v| v.as_f64()).unwrap_or(0.0);
    let category = body.get("category").and_then(|v| v.as_str()).unwrap_or("general");
    let commission_enabled = body.get("commission_enabled").and_then(|v| v.as_bool()).unwrap_or(false);
    let commission_rate = body.get("commission_rate").and_then(|v| v.as_u64()).unwrap_or(0) as u32;

    match db.create_shop_item(
        &claims.sub, item_type, media_urls, title, description,
        price_fxb, price_usd, category, commission_enabled, commission_rate,
    ) {
        Ok(id) => HttpResponse::Ok().json(json!({
            "status": "success",
            "item_id": id
        })),
        Err(error) => HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("CrÃ©ation de l'offre impossible: {}", error)
        })),
    }
}

