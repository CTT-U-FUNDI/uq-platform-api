//   1 000 - 9 999    -> 0.5%
//   10 000 - 99 999  -> 0.25%
//   >= 100 000       -> 0.1%
//
// Wallet virtuel :
//   Devise locale/internationale -> 0.1%
//   Crypto (BTC/ETH/USDT...)     -> 1%
//
// P2P brut : 0% (pas de frais, echange direct)
// ============================================================

fn calculate_fee_points(amount_points: u64, from_currency: &str) -> u64 {
    let amount_fxb = amount_points as f64 / 100.0; // centimes -> FXB
    let is_crypto = matches!(from_currency.to_uppercase().as_str(),
        "BTC" | "ETH" | "USDT" | "USDC" | "BNB" | "XRP" | "SOL" | "ADA" | "DOGE" |
        "TRX" | "DOT" | "MATIC" | "LTC" | "SHIB" | "AVAX" | "LINK" | "ATOM" | "XLM" | "ALGO" | "XMR"
    );

    let pct = if from_currency.to_uppercase() == "FXB" {
        // FXB direct : degressif
        if amount_fxb >= 100_000.0 { 0.001 }       // 0.1%
        else if amount_fxb >= 10_000.0 { 0.0025 }  // 0.25%
        else if amount_fxb >= 1_000.0 { 0.005 }    // 0.5%
        else { 0.01 }                              // 1% (< 1000)
    } else if is_crypto {
        0.01                                       // Crypto : 1%
    } else {
        0.001                                      // Devise locale/int : 0.1%
    };

    let fee = (amount_fxb * pct * 100.0).ceil() as u64; // FXB -> centimes
    fee.max(1) // minimum 1 centime
}


