// HELPER : Taux live FXB depuis l'oracle
// Retourne un HashMap devise -> FXB (live ou fallback)
// ============================================================
async fn taux_live_fxb() -> std::collections::HashMap<String, f64> {
    let live = crate::public_routes::taux_du_jour().await;
    let mut map = std::collections::HashMap::new();
    
    let Some(fxb_usd) = crate::persistence::load_prix()
        .prix_actuel
        .parse::<f64>()
        .ok()
        .filter(|price| price.is_finite() && *price > 0.0) else {
            return map;
        };

    // Devises : 1 unitÃ© de devise = X BORB, selon le cours backend du BORB.
    for (code, units_per_usd) in &live.rates {
        if units_per_usd.is_finite() && *units_per_usd > 0.0 {
            map.insert(code.clone(), 1.0 / (units_per_usd * fxb_usd));
        }
    }
    
    // Fallbacks si l'oracle n'a pas la devise
    let fallbacks = [
        ("CDF", 0.000433),
        ("USD", 1.0),
        ("EUR", 0.892),
        ("GBP", 0.79),
        ("XOF", 0.00165),
        ("XAF", 0.00153),
        ("NGN", 0.000645),
        ("KES", 0.00775),
        ("ZAR", 0.054),
        ("MAD", 0.10),
        ("GHS", 0.0645),
        ("BTC", 0.0000105),
        ("ETH", 0.000286),
        ("USDT", 1.0),
        ("XAU", 0.0005),
        ("FXB", 1.0),
    ];
    
    for (code, taux) in fallbacks.iter() {
        map.entry(code.to_string()).or_insert(*taux / fxb_usd);
    }
    
    map
}


// ============================================================
// CLAIM WITH PIN - Reclamation 30% avec PIN owner unique
// POST /api/distribution/claim-with-pin
// Body: { code_pin: "3543", uq_profil2: "UQ-230354360" }
// ============================================================
pub async fn distribution_claim_with_pin(body: web::Json<serde_json::Value>) -> HttpResponse {
    use rusqlite::Connection;

    let code_pin = body.get("code_pin").and_then(|v| v.as_str()).unwrap_or("");
    let uq_profil2 = body.get("uq_profil2").and_then(|v| v.as_str()).unwrap_or("UQ-732337351");

    if code_pin.is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "Code PIN requis"
        }));
    }

    let owner_uq = "UQ-00000001";
    let now = chrono::Utc::now().timestamp();

    // 1. Ouvrir DB owner + verifier PIN
    let owner_db = format!("data/users/{}.db", owner_uq.replace("-", "_").to_lowercase());
    let conn_owner = match Connection::open(&owner_db) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("DB owner: {}", e)
        })),
    };

    // 2. Lire salt + hash PIN
    let salt: String = conn_owner.query_row(
        "SELECT value FROM settings WHERE key = 'login_pin_salt'",
        [], |row| row.get(0)
    ).unwrap_or_else(|_| format!("uq_login_salt_{}", owner_uq));

    let stored_hash: String = conn_owner.query_row(
        "SELECT value FROM settings WHERE key = 'login_pin_hash'",
        [], |row| row.get(0)
    ).unwrap_or_default();

    // 3. Calculer hash PIN
    use sha2::{Sha256, Digest};
    let mut hasher = Sha256::new();
    hasher.update(format!("{}:{}", code_pin, salt).as_bytes());
    let computed = format!("{:x}", hasher.finalize());

    if computed != stored_hash {
        eprintln!("[CLAIM-PIN] PIN incorrect");
        return HttpResponse::Forbidden().json(json!({
            "status": "error",
            "message": "Code PIN incorrect"
        }));
    }

    eprintln!("[CLAIM-PIN] PIN valide, reclamation pour {}", uq_profil2);

    // 4. Lire solde owner
    let owner_points: i64 = conn_owner.query_row(
        "SELECT COALESCE(points, 0) FROM balance WHERE id = 1",
        [], |row| row.get(0)
    ).unwrap_or(0);

    if owner_points <= 0 {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "Solde Profil 1 vide"
        }));
    }

    // 5. Calculer 30%
    let montant_30_pct = (owner_points as f64 * 0.30) as i64;

    if montant_30_pct <= 0 {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "Montant 30% nul"
        }));
    }

    // 6. Ouvrir DB profil 2
    let p2_db = format!("data/users/{}.db", uq_profil2.replace("-", "_").to_lowercase());
    let conn_p2 = match Connection::open(&p2_db) {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("DB profil 2: {}", e)
        })),
    };

    // 7. Lire solde actuel profil 2
    let p2_points_avant: i64 = conn_p2.query_row(
        "SELECT COALESCE(points, 0) FROM balance WHERE id = 1",
        [], |row| row.get(0)
    ).unwrap_or(0);

    // 8. DEBITER owner (-30%)
    if let Err(e) = conn_owner.execute(
        "UPDATE balance SET points = points - ?1 WHERE id = 1",
        rusqlite::params![montant_30_pct],
    ) {
        return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur debit owner: {}", e)
        }));
    }

    // 9. CREDITER profil 2 (+30%)
    if let Err(e) = conn_p2.execute(
        "UPDATE balance SET points = points + ?1 WHERE id = 1",
        rusqlite::params![montant_30_pct],
    ) {
        // Rollback owner
        let _ = conn_owner.execute(
            "UPDATE balance SET points = points + ?1 WHERE id = 1",
            rusqlite::params![montant_30_pct],
        );
        return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur credit profil2: {}", e)
        }));
    }

    // 10. Lire nouveaux soldes
    let owner_points_apres: i64 = conn_owner.query_row(
        "SELECT COALESCE(points, 0) FROM balance WHERE id = 1",
        [], |row| row.get(0)
    ).unwrap_or(0);

    let p2_points_apres: i64 = conn_p2.query_row(
        "SELECT COALESCE(points, 0) FROM balance WHERE id = 1",
        [], |row| row.get(0)
    ).unwrap_or(0);

    // 11. Sync multi_wallets
    let conn_idx = match Connection::open("uq_index.db") {
        Ok(c) => c,
        Err(e) => return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("DB index: {}", e)
        })),
    };

    let owner_fxb = owner_points_apres as f64 / 100.0;
    let _ = conn_idx.execute(
        "UPDATE multi_wallets SET balance = ?1, updated_at = ?2 WHERE uq_number = ?3 AND currency = 'FXB'",
        rusqlite::params![owner_fxb, now, owner_uq],
    );

    let p2_fxb = p2_points_apres as f64 / 100.0;
    let _ = conn_idx.execute(
        "INSERT INTO multi_wallets (uq_number, currency, balance, updated_at)
         VALUES (?1, 'FXB', ?2, ?3)
         ON CONFLICT(uq_number, currency) DO UPDATE SET balance = ?2, updated_at = ?3",
        rusqlite::params![uq_profil2, p2_fxb, now],
    );

    eprintln!("[CLAIM-PIN] SUCCES: {} points -> {}", montant_30_pct, uq_profil2);

    HttpResponse::Ok().json(json!({
        "status": "success",
        "message": format!("Reclamation de {} points (30%) effectuee", montant_30_pct),
        "montant_points": montant_30_pct,
        "montant_fxb": montant_30_pct as f64 / 100.0,
        "owner_avant": owner_points,
        "owner_apres": owner_points_apres,
        "profil2_avant": p2_points_avant,
        "profil2_apres": p2_points_apres,
        "owner_fxb": owner_fxb,
        "profil2_fxb": p2_fxb
    }))
}

