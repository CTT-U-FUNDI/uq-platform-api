            "date": chrono::DateTime::from_timestamp(ts, 0)
                .map(|d| d.format("%Y-%m-%d %H:%M").to_string())
                .unwrap_or_default()
        }))
    });
    
    let mut history = Vec::new();
    if let Ok(r) = rows {
        for row in r {
            if let Ok(v) = row {
                history.push(v);
            }
        }
    }
    
    let total_in: i64 = history.iter()
        .filter(|h| h["type"] == "receive")
        .map(|h| h["amount"].as_i64().unwrap_or(0))
