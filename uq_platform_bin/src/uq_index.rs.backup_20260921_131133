            -- 12. REFERRALS
            CREATE TABLE IF NOT EXISTS referrals (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                referrer_id TEXT NOT NULL,
                referred_id TEXT NOT NULL,
                commission_earned INTEGER DEFAULT 0,
                created_at INTEGER NOT NULL
