use std::collections::HashMap;

const FIXORB_REGISTRY: &str = "data/fixorb_registry.json";

#[derive(Debug, Clone, Serialize, Deserialize, Default)]
pub struct FxbEntry {
    pub fxb_id: String,
    pub owner_uq: String,
    pub from_uq: Option<String>,
    pub amount: u128,
    pub created_at: i64,
    pub last_seen_at: i64,
    pub status: String,
}

pub fn load_registry() -> HashMap<String, FxbEntry> {
    if std::path::Path::new(FIXORB_REGISTRY).exists() {
        if let Ok(content) = std::fs::read_to_string(FIXORB_REGISTRY) {
            if let Ok(registry) = serde_json::from_str::<HashMap<String, FxbEntry>>(&content) {
                return registry;
            }
        }
    }
    HashMap::new()
}

pub fn save_registry(registry: &HashMap<String, FxbEntry>) -> Result<(), String> {
    let json = serde_json::to_string_pretty(registry).map_err(|e| e.to_string())?;
    std::fs::write(FIXORB_REGISTRY, json).map_err(|e| e.to_string())?;
    Ok(())
}

pub fn register_fxb(fxb_id: &str, owner_uq: &str, from_uq: &str, amount: u128, now: i64) {
    let mut registry = load_registry();
    let entry = FxbEntry {
        fxb_id: fxb_id.to_string(),
        owner_uq: owner_uq.to_string(),
        from_uq: if from_uq.is_empty() { None } else { Some(from_uq.to_string()) },
        amount,
        created_at: now,
        last_seen_at: now,
        status: "active".to_string(),
    };
    registry.insert(fxb_id.to_string(), entry);
    if let Err(e) = save_registry(&registry) {
        eprintln!("Erreur registre: {}", e);
    } else {
        // Troncature sÃ»re (jamais de panic sur un id court)
        let court: String = fxb_id.chars().take(16).collect();
        eprintln!("FXB enregistre: {}", court);
    }
}

pub fn verify_fxb(fxb_id: &str) -> bool {
    load_registry().contains_key(fxb_id)
}

pub fn count_fxb_by_owner(owner_uq: &str) -> usize {
    load_registry().values().filter(|e| e.owner_uq == owner_uq).count()
}

pub fn sum_fxb_by_owner(owner_uq: &str) -> u128 {
    load_registry().values().filter(|e| e.owner_uq == owner_uq).map(|e| e.amount).sum()
}

