// ðŸªž MIROIR BLOCKORB â€” le disque dur suit la rÃ©alitÃ© SQLite
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//
// Les soldes dÃ©pensables vivent dans `balance.points` (SQLite).
// Le BlockOrb est le disque dur global : il doit reflÃ©ter les mÃªmes
// montants, sinon les deux registres divergent (soldes BlockOrb Ã  0
// alors que l'utilisateur a des FXB).
//
// RÃ¨gles :
//   - dÃ©bit expÃ©diteur = montant + frais
//   - crÃ©dit destinataire = montant
//   - frais rÃ©partis dans les 6 Cases (distribuer_frais)
//   - si l'expÃ©diteur n'a pas assez dans le BlockOrb (compte Â« historique Â»
//     crÃ©ditÃ© avant la mise en place du miroir), la diffÃ©rence est
//     prÃ©levÃ©e sur le TrÃ©sor (cases[0]) â†’ l'invariant 40 Md reste exact
//   - BEST-EFFORT : ne bloque jamais le transfert dÃ©jÃ  validÃ© en SQLite
pub fn mirroir_transfert(
    sender: &str,
    recipient: &str,
    amount_points: u128,
    fee_points: u128,
) -> Result<(), String> {
    let mut orb = load_global_orb();
    let avant = orb.clone();

    // femto-FXB par point (1 FXB = 100 points)
    let femto_par_point = crate::montant::FEMTO_PAR_FXB / 100;
    let total = (amount_points + fee_points) * femto_par_point;
    let recu = amount_points * femto_par_point;
    let frais = fee_points * femto_par_point;

    if !orb.comptes.contains_key(sender) {
        return Err(format!("portefeuille {} absent du BlockOrb", sender));
    }
    if !orb.comptes.contains_key(recipient) {
        return Err(format!("portefeuille {} absent du BlockOrb", recipient));
    }

    // 1. RÃ©conciliation Ã©ventuelle depuis le TrÃ©sor
    let solde_sender = orb.comptes.get(sender).map(|p| p.solde).unwrap_or(0);
    if solde_sender < total {
        let manque = total - solde_sender;
        if orb.cases[0] < manque {
            return Err(format!(
                "Tresor insuffisant pour reconciler {} (manque {} femto)",
                sender, manque
            ));
        }
        orb.cases[0] -= manque;
        if let Some(p) = orb.comptes.get_mut(sender) {
            p.solde = total;
        }
        eprintln!(
            "ðŸªž Reconcilie {} : +{} femto preleves sur le Tresor",
            sender, manque
        );
    }

    // 2. DÃ©bit / crÃ©dit
    if let Some(p) = orb.comptes.get_mut(sender) {
        p.solde = p.solde.saturating_sub(total);
    }
    if let Some(p) = orb.comptes.get_mut(recipient) {
        p.solde = p.solde.saturating_add(recu);
    }

    // 3. Frais â†’ 6 Cases (30/40/15/10/5/0)
    if frais > 0 {
        if let Err(e) = orb.distribuer_frais(frais) {
            orb = avant;
            return Err(e);
        }
    }

    // 4. Invariant
    if !orb.verifier() {
        orb = avant;
        return Err("invariant casse par le miroir â€” BlockOrb inchange".to_string());
    }

    // 5. Sceller le bloc (numÃ©ro + horodatage + hash de chaÃ®nage)
    orb.sceller_bloc();

    save_global_orb(&orb)
}

/// ðŸªž RÃ‰CONCILIATION â€” aligne le BlockOrb sur les soldes SQLite.
///
/// Pour chaque portefeuille visÃ© possÃ©dant une DB :
///   cible = balance.points * FEMTO_PAR_FXB / 100
/// La diffÃ©rence est prÃ©levÃ©e sur le TrÃ©sor (cases[0]) ou lui est rendue,
/// ce qui prÃ©serve exactement l'invariant des 40 Md FXB.
/// Les comptes prÃ©sents dans data/users mais absents du BlockOrb sont crÃ©Ã©s.
///
/// `seulement` = Some(uq) pour ne traiter qu'un compte (cas non-admin).
/// Retourne (uq, delta_femto, applique) par compte modifiÃ©.
pub fn reconcilier_blockorb(seulement: Option<&str>) -> Result<Vec<(String, i128, bool)>, String> {
    let mut orb = load_global_orb();
    let femto_par_point = crate::montant::FEMTO_PAR_FXB / 100;

    // â”€â”€â”€ DÃ©terminer les comptes Ã  traiter â”€â”€â”€
    let mut uqs: Vec<String> = match seulement {
        Some(uq) => vec![uq.to_string()],
        None => {
            let mut v: Vec<String> = orb.comptes.keys().cloned().collect();

            // Comptes prÃ©sents sur disque mais absents du BlockOrb
            if let Ok(entries) = std::fs::read_dir(USERS_DIR) {
                for entry in entries.flatten() {
                    let nom = entry.file_name().to_string_lossy().to_string();
                    if !nom.starts_with("uq_") || !nom.ends_with(".db") {
                        continue;
                    }
                    let brut = &nom[3..nom.len() - 3]; // entre "uq_" et ".db"
                    if brut.is_empty() || !brut.chars().all(|c| c.is_ascii_digit()) {
                        continue; // ignore uq_xxx.db, .db, backups...
                    }
                    let uq = format!("UQ-{}", brut);
                    if !v.contains(&uq) {
                        v.push(uq);
                    }
                }
            }
            v
        }
    };

    uqs.sort();
    uqs.dedup();

    let mut rapport: Vec<(String, i128, bool)> = Vec::new();

    for uq in uqs {
        let db_path = format!("data/users/{}.db", uq.replace("-", "_").to_lowercase());
        if !std::path::Path::new(&db_path).exists() {
            continue;
        }

        let points: i64 = match rusqlite::Connection::open(&db_path) {
            Ok(conn) => conn
                .query_row("SELECT points FROM balance WHERE id = 1", [], |r| r.get(0))
                .unwrap_or(0),
            Err(_) => continue,
        };

        let cible = (points.max(0) as u128) * femto_par_point;
        let actuel = orb.comptes.get(&uq).map(|p| p.solde).unwrap_or(0);

        // Rien Ã  faire si le solde est dÃ©jÃ  bon ET que le portefeuille existe
        if actuel == cible && orb.comptes.contains_key(&uq) {
            continue;
        }

        if cible > actuel {
            let manque = cible - actuel;
            if orb.cases[0] < manque {
                rapport.push((uq.clone(), manque as i128, false)); // TrÃ©sor insuffisant
                continue;
            }
            orb.cases[0] -= manque;
            rapport.push((uq.clone(), manque as i128, true));
        } else {
            let surplus = actuel - cible;
            orb.cases[0] += surplus;
            rapport.push((uq.clone(), -(surplus as i128), true));
        }

        // CrÃ©e le portefeuille s'il n'existait pas encore dans le BlockOrb
        let portefeuille = orb
            .comptes
            .entry(uq.clone())
            .or_insert_with(crate::block_orb::Portefeuille::new);
        portefeuille.solde = cible;
    }

    if !orb.verifier() {
        return Err("Invariant casse â€” reconciliation annulee (aucune ecriture)".to_string());
    }

    save_global_orb(&orb)?;
    Ok(rapport)
}

