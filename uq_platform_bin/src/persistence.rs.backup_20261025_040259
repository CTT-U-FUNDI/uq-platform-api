/// Sauvegarde le BlockOrb global.
///
/// ðŸ“ SPÃ‰CIFICATION Â« TAILLE FIXE Â» : on refuse d'Ã©crire un BlockOrb qui
/// dÃ©passe MAX_BLOCKORB_BYTES (50 KB). Comme l'historique n'y est plus
/// stockÃ©, la taille ne dÃ©pend que du nombre de comptes ; le garde-fou
/// Ã©vite qu'un champ non bornÃ© ne rÃ©introduise une croissance silencieuse.
pub fn save_global_orb(orb: &BlockOrb) -> Result<(), String> {
    let json = serde_json::to_string_pretty(orb).map_err(|e| e.to_string())?;

    if json.len() > crate::blockchain_lib::MAX_BLOCKORB_BYTES {
        return Err(format!(
            "BlockOrb trop gros : {} octets > {} octets (taille fixe violee)",
            json.len(),
            crate::blockchain_lib::MAX_BLOCKORB_BYTES
        ));
    }

    fs::write(global_orb_path(), json).map_err(|e| e.to_string())?;
    Ok(())
}

