pub async fn zando_contact_request(body: web::Json<serde_json::Value>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    
    let requester_id = body.get("requester_id").and_then(|v| v.as_str()).unwrap_or("");
    let target_id = body.get("target_id").and_then(|v| v.as_str()).unwrap_or("");
    let field = body.get("field").and_then(|v| v.as_str()).unwrap_or("number");
    
    if requester_id.is_empty() || target_id.is_empty() {
        return HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": "requester_id et target_id requis"
        }));
    }
    
    match db.create_contact_request(requester_id, target_id, field) {
        Ok(request_id) => HttpResponse::Ok().json(json!({
            "status": "success",
            "request_id": request_id
        })),
        Err(e) => HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": e
        })),
    }
}

