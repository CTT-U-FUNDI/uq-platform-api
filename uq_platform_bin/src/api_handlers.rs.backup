pub async fn bubble_create() -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    db.publish_offer("owner", "Bulle crÃ©Ã©e", 0, 0);
    HttpResponse::Ok().json(json!({"status":"success","bubble_created":true}))
}
pub async fn bubble_transfer(req: actix_web::HttpRequest, body: web::Json<TransferRequest>) -> HttpResponse {
    // Require authenticated user role (user, admin, guardian)
    match crate::auth::AuthManager::require_role(&req, &["user", "admin", "guardian"]) {
        Ok(_claims) => {
            let db = Database::shared("uq_platform_db.json");
            db.record_transaction(&body.sender, &body.recipient, body.amount_points, body.fee_points);
            HttpResponse::Ok().json(json!({"status":"success","persisted":true}))
        }
        Err(resp) => resp,
    }
}
