// ═══════════════════════════════════════════════════════════════
// JOURNAL INDIVIDUEL — EXPORT
// ═══════════════════════════════════════════════════════════════

pub async fn journal_export(path: web::Path<String>) -> HttpResponse {
    let account_id = path.into_inner();
    let db = Database::shared("uq_platform_db.json");
    let journal = db.get_journal(&account_id);
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "account_id": account_id,
        "entries": journal,
        "total_entries": journal.len(),
        "exported_at": chrono::Utc::now().to_rfc3339()
    }))
}

pub async fn journal_summary(path: web::Path<String>) -> HttpResponse {
    let account_id = path.into_inner();
    let db = Database::shared("uq_platform_db.json");
    let journal = db.get_journal(&account_id);
    
    let total_sent: i64 = journal.iter()
        .filter(|e| e.get("tx_type").and_then(|v| v.as_str()) == Some("transfer_sent"))
        .map(|e| e.get("amount_points").and_then(|v| v.as_i64()).unwrap_or(0))
        .sum();
    
    let total_received: i64 = journal.iter()
        .filter(|e| e.get("tx_type").and_then(|v| v.as_str()) == Some("transfer_received"))
        .map(|e| e.get("amount_points").and_then(|v| v.as_i64()).unwrap_or(0))
        .sum();
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "account_id": account_id,
        "total_entries": journal.len(),
        "total_sent": total_sent,
        "total_received": total_received,
        "net": total_received - total_sent
    }))
}







// ═══════════════════════════════════════════════════════════════
// 🛒 ZANDO — HANDLERS
// ═══════════════════════════════════════════════════════════════

// ─── ZANDO ÉLÉMENTS (6 handlers) ───

/// Crée un nouvel élément Zando
pub async fn zando_item_create(body: web::Json<serde_json::Value>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    
    let shop_id = body.get("shop_id").and_then(|v| v.as_str()).unwrap_or("");
    let item_type = body.get("type").and_then(|v| v.as_str()).unwrap_or("text");
    let media_urls = body.get("media_urls").and_then(|v| v.as_str()).unwrap_or("[]");
    let title = body.get("title").and_then(|v| v.as_str()).unwrap_or("");
    let description = body.get("description").and_then(|v| v.as_str()).unwrap_or("");
    let price_fxb = body.get("price_fxb").and_then(|v| v.as_u64()).unwrap_or(0);
    let price_usd = body.get("price_usd").and_then(|v| v.as_f64()).unwrap_or(0.0);
    let category = body.get("category").and_then(|v| v.as_str()).unwrap_or("general");
    let commission_enabled = body.get("commission_enabled").and_then(|v| v.as_bool()).unwrap_or(false);
    let commission_rate = body.get("commission_rate").and_then(|v| v.as_u64()).unwrap_or(0) as u32;
    
    let id = db.create_shop_item(
        shop_id, item_type, media_urls, title, description,
        price_fxb, price_usd, category, commission_enabled, commission_rate,
    );
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "item_id": id
    }))
}

/// Récupère les éléments d'une boutique
pub async fn zando_items_get(path: web::Path<String>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    let shop_id = path.into_inner();
    let items = db.get_shop_items(&shop_id);
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "items": items,
        "total": items.len()
    }))
}

/// Récupère un élément par ID
pub async fn zando_item_get(path: web::Path<String>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    let id = path.into_inner();
    
    match db.get_shop_item_by_id(&id) {
        Some(item) => HttpResponse::Ok().json(json!({
            "status": "success",
            "item": item
        })),
        None => HttpResponse::NotFound().json(json!({
            "status": "error",
            "message": "Item not found"
        }))
    }
}

/// Met à jour un élément
pub async fn zando_item_update(
    path: web::Path<String>,
    body: web::Json<serde_json::Value>,
) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    let id = path.into_inner();
    
    let title = body.get("title").and_then(|v| v.as_str()).unwrap_or("");
    let description = body.get("description").and_then(|v| v.as_str()).unwrap_or("");
    let price_fxb = body.get("price_fxb").and_then(|v| v.as_u64()).unwrap_or(0);
    
    match db.update_shop_item(&id, title, description, price_fxb) {
        Ok(()) => HttpResponse::Ok().json(json!({"status": "success"})),
        Err(e) => HttpResponse::BadRequest().json(json!({"status": "error", "message": e}))
    }
}

/// Supprime un élément
pub async fn zando_item_delete(path: web::Path<String>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    let id = path.into_inner();
    
    match db.delete_shop_item(&id) {
        Ok(()) => HttpResponse::Ok().json(json!({"status": "success"})),
        Err(e) => HttpResponse::BadRequest().json(json!({"status": "error", "message": e}))
    }
}

/// Publie un élément
pub async fn zando_item_publish(path: web::Path<String>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    let id = path.into_inner();
    
    match db.publish_shop_item(&id) {
        Ok(()) => HttpResponse::Ok().json(json!({"status": "success"})),
        Err(e) => HttpResponse::BadRequest().json(json!({"status": "error", "message": e}))
    }
}

// ─── ZANDO AGENTS (3 handlers) ───

/// Devient agent commissionnaire
pub async fn zando_agent_become(body: web::Json<serde_json::Value>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    
    let item_id = body.get("item_id").and_then(|v| v.as_str()).unwrap_or("");
    let user_id = body.get("user_id").and_then(|v| v.as_str()).unwrap_or("");
    let commission_rate = body.get("commission_rate").and_then(|v| v.as_u64()).unwrap_or(0) as u32;
    
    match db.add_item_agent(item_id, user_id, commission_rate) {
        Ok(()) => HttpResponse::Ok().json(json!({"status": "success"})),
        Err(e) => HttpResponse::BadRequest().json(json!({"status": "error", "message": e}))
    }
}

/// Récupère les agents d'un élément
pub async fn zando_agents_get(path: web::Path<String>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    let item_id = path.into_inner();
    let agents = db.get_item_agents(&item_id);
    
    HttpResponse::Ok().json(json!({
        "status": "success",
        "agents": agents,
        "total": agents.len()
    }))
}

/// Enregistre une vente via un agent
pub async fn zando_agent_sale(body: web::Json<serde_json::Value>) -> HttpResponse {
    let db = Database::shared("uq_platform_db.json");
    
    let item_id = body.get("item_id").and_then(|v| v.as_str()).unwrap_or("");
    let agent_id = body.get("agent_id").and_then(|v| v.as_str()).unwrap_or("");
    let sale_amount = body.get("sale_amount_fxb").and_then(|v| v.as_u64()).unwrap_or(0);
    
    match db.record_agent_sale(item_id, agent_id, sale_amount) {
        Ok(commission) => HttpResponse::Ok().json(json!({
            "status": "success",
            "commission_earned": commission
        })),
        Err(e) => HttpResponse::BadRequest().json(json!({"status": "error", "message": e}))
    }
}

