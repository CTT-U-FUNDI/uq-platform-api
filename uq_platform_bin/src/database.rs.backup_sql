            let _ = conn.execute(
                "INSERT OR REPLACE INTO sessions (id, account_id, token, created_at, expires_at) VALUES (?1, ?2, ?3, ?4, ?5)",
                rusqlite::params![id, account_id, token, chrono::Utc::now().timestamp(), expires_at],
            );
        }
        self.save();
    }
