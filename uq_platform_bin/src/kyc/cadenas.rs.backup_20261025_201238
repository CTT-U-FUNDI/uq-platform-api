// ============================================================
// RESYNCHRONISER CADENAS - Recalcule hash_brut + hash_transforme
// depuis l'identite actuelle (nom/prenom/date/lieu/pays).
// Corrige les desalignements causes par validate_kyc_manual.py
// ou auto-KYC owner sans recalcul du hash.
// ============================================================
pub fn resynchroniser_cadenas(uq_number: &str) -> Result<(), String> {
    use rusqlite::{Connection, params};
    
    let db_path = {
        let exe_dir = std::env::current_exe()
            .ok()
            .and_then(|p| p.parent().map(|d| d.to_path_buf()))
            .unwrap_or_else(|| std::path::PathBuf::from("."));
        exe_dir.join(format!("data/users/{}.db", uq_number.replace("-", "_").to_lowercase()))
            .to_string_lossy()
            .to_string()
    };
    let conn = Connection::open(&db_path).map_err(|e| format!("DB: {}", e))?;
    
    // 1. Lire l'identite actuelle
    let identite: Result<(String, String, String, String, String, String), _> = conn.query_row(
        "SELECT COALESCE(nom,''), COALESCE(prenom,''), COALESCE(date_naissance,''), 
                COALESCE(lieu_naissance,''), COALESCE(pays,''), COALESCE(numero_piece,'')
         FROM cadenas_verification WHERE id = 1",
        [],
        |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?, row.get(4)?, row.get(5)?)),
    );
    
    let (nom, prenom, date, lieu, pays, piece) = identite
        .map_err(|e| format!("Identite introuvable: {}", e))?;
    
    if nom.is_empty() && prenom.is_empty() {
        return Err("Identite vide - rien a resynchroniser".to_string());
    }
    
    // 2. Recalculer le hash
    let secret = std::env::var("KYC_SECRET_SERVER")
        .unwrap_or_else(|_| "uq_default_secret_change_me".to_string());
    
    let brut = format!("{}|{}|{}|{}|{}|{}|{}", 
        uq_number, nom, prenom, date, lieu, pays, piece);
    
    use sha2::{Sha256, Digest};
    let mut hasher = Sha256::new();
    hasher.update(format!("{}:{}", secret, brut).as_bytes());
    let hash_brut = hex::encode(hasher.finalize());
    
    let mut hasher2 = Sha256::new();
    hasher2.update(format!("{}:{}", secret, hash_brut).as_bytes());
    let hash_transforme = hex::encode(hasher2.finalize());
    
    // 3. Mettre a jour
    conn.execute(
        "UPDATE cadenas_verification 
         SET hash_brut = ?1, hash_transforme = ?2, updated_at = ?3
         WHERE id = 1",
        params![hash_brut, hash_transforme, chrono::Utc::now().timestamp()],
    ).map_err(|e| format!("UPDATE: {}", e))?;
    
    eprintln!("âœ… Cadenas resynchronise pour {}", uq_number);
    Ok(())
}
