use std::collections::HashMap;
use serde::{Serialize, Deserialize};
use crate::montant::{MontantFxB, CAPACITE_TOTALE, FEMTO_PAR_FXB};

// ═══ LES 6 CASES (formes de l'eau) ═══
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
pub enum FormeEau {
    Ocean,      // 💰 Trésor
    Nuages,     // 💸 Frais
    Rivieres,   // 🏆 Récompenses
    Glaciers,   // ❄️ Épargne
    Nappes,     // 💳 Crédit
    Vapeur,     // 🛡️ Bouclier
}

impl FormeEau {
    pub fn all() -> [FormeEau; 6] {
        [
            FormeEau::Ocean,
            FormeEau::Nuages,
            FormeEau::Rivieres,
            FormeEau::Glaciers,
            FormeEau::Nappes,
            FormeEau::Vapeur,
        ]
    }
    
    pub fn index(&self) -> usize {
        match self {
            FormeEau::Ocean => 0,
            FormeEau::Nuages => 1,
            FormeEau::Rivieres => 2,
            FormeEau::Glaciers => 3,
            FormeEau::Nappes => 4,
            FormeEau::Vapeur => 5,
        }
    }
}


// === TRACABILITE FXB ===
// ⚠️ SPÉCIFICATION « BLOCKORB À TAILLE FIXE » :
// l'historique des transactions NE VIT PLUS ICI. Il est stocké dans la DB
// locale de chaque utilisateur (table `transactions`), avec `fxb_id`,
// `prev_hash` et `block_number`. Le BlockOrb ne contient que l'état présent.
//
// La structure ci-dessous n'est conservée que pour la lecture des fragments
// d'historique échangés entre voisins (history_recovery.rs). Elle n'est
// JAMAIS sérialisée dans data/block_orb_global.json.
#[derive(Debug, Clone, Serialize, Deserialize, Default)]
pub struct TxFxb {
    pub fxb_id: String,
    pub from_uq: String,
    pub to_uq: String,
    pub amount: u128,
    pub fee: u128,
    pub timestamp: i64,
    pub signature: String,
    pub cadenas_hash: String,
    pub universal_key: String,
    pub prev_hash: String,
    pub status: String,
    #[serde(default)]
    pub block_number: u64,
}

// ═══ LE DISQUE DUR — TAILLE FIXE ═══
/// 🔐 Un portefeuille : uniquement l'ÉTAT PRÉSENT (taille bornée).
///
/// Ne contient volontairement AUCUN historique : c'est ce qui garantit que
/// le BlockOrb ne grossit jamais (≤ MAX_BLOCKORB_BYTES).
#[derive(Debug, Clone, Serialize, Deserialize, Default)]
pub struct Portefeuille {
    /// Solde en femto-FXB
    pub solde: u128,

    /// 🔐 CADENAS (hash transformé, stocké sous autre forme)
    pub cadenas: Option<String>,

    /// Date de création du cadenas
    pub cadenas_at: Option<i64>,

    /// 🚨 Alerte piratage
    pub alerte_piratage: bool,

    /// Détails de l'alerte
    pub alerte_details: Option<String>,
}

impl Portefeuille {
    pub fn new() -> Self {
        Self {
            solde: 0,
            cadenas: None,
            cadenas_at: None,
            alerte_piratage: false,
            alerte_details: None,
        }
    }

    pub fn solde(&self) -> u128 {
        self.solde
    }

    pub fn set_solde(&mut self, nouveau: u128) {
        self.solde = nouveau;
    }

    pub fn ajouter(&mut self, montant: u128) -> Result<(), String> {
        self.solde = self.solde.checked_add(montant).ok_or("Depassement")?;
        Ok(())
    }

    pub fn retirer(&mut self, montant: u128) -> Result<(), String> {
        self.solde = self.solde.checked_sub(montant).ok_or("Solde insuffisant")?;
        Ok(())
    }

    /// Pose le cadenas local (le hash complet reste dans la DB du compte)
    pub fn poser_cadenas(&mut self, cadenas: String, at: i64) {
        self.cadenas = Some(cadenas);
        self.cadenas_at = Some(at);
    }

    pub fn geler(&mut self, details: String) {
        self.alerte_piratage = true;
        self.alerte_details = Some(details);
    }

    pub fn est_gele(&self) -> bool {
        self.alerte_piratage
    }
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct BlockOrb {
    /// Les 6 Cases (en femto-FXB, u128)
    pub cases: [u128; 6],
    
    /// 🎁 Enveloppe UBI (10 M FXB, preleve du Tresor)
    #[serde(default)]
    pub ubi_enveloppe: u128,
    
    /// Les comptes utilisateurs — ÉTAT PRÉSENT uniquement (aucun historique)
    pub comptes: HashMap<String, Portefeuille>,
    
    /// 🎁 Les comptes CADEAUX (parrainage + UBI)
    #[serde(default)]
    pub comptes_cadeaux: HashMap<String, u128>,
    
    /// Numéro de bloc (pour historique)
    #[serde(default)]
    pub block_number: u64,
    
    /// Timestamp du dernier bloc
    #[serde(default)]
    pub last_block_at: i64,

    /// 🧬 Hash du dernier bloc (chaînage global, taille fixe)
    #[serde(default)]
    pub last_block_hash: String,
}

impl BlockOrb {
    /// Crée un nouveau BlockOrb avec la capacité initiale
    pub fn new() -> Self {
        let mut cases = [0u128; 6];
        
        // Enveloppe UBI : 10 M FXB (preleve du Tresor)
        let ubi_enveloppe = 10_000_000u128 * FEMTO_PAR_FXB;
        
        // Repartition initiale (Tresor reduit de 10M)
        cases[0] = 31_110_000_000 * FEMTO_PAR_FXB;  // Tresor (31 120 - 10)
        cases[1] = 2_240_000_000 * FEMTO_PAR_FXB;   // Frais
        cases[2] = 2_240_000_000 * FEMTO_PAR_FXB;   // Recompenses
        cases[3] = 2_240_000_000 * FEMTO_PAR_FXB;   // Epargne
        cases[4] = 1_320_000_000 * FEMTO_PAR_FXB;   // Credit
        cases[5] = 840_000_000 * FEMTO_PAR_FXB;     // Bouclier
        
        Self {
            cases,
            ubi_enveloppe,
            comptes: HashMap::new(),
            comptes_cadeaux: HashMap::new(),
            block_number: 0,
            last_block_at: chrono::Utc::now().timestamp(),
            last_block_hash: String::new(),
        }
    }

    // ═══════════════════════════════════════════════════════════
    // 📏 TAILLE FIXE (spécification : « ~50 KB max, JAMAIS plus »)
    // ═══════════════════════════════════════════════════════════

    /// En-tête du bloc courant (tout ce qui est haché)
    pub fn header(&self) -> crate::blockchain_lib::BlockHeader {
        crate::blockchain_lib::BlockHeader {
            block_number: self.block_number,
            last_block_at: self.last_block_at,
            somme_cases: self.somme_cases(),
            ubi_enveloppe: self.ubi_enveloppe,
            somme_comptes: self.somme_comptes(),
            prev_hash: self.last_block_hash.clone(),
        }
    }

    /// Scelle le bloc : incrémente le numéro, horodate et calcule le hash.
    /// (le hash du bloc précédent sert de `prev_hash` → chaînage global)
    pub fn sceller_bloc(&mut self) {
        self.block_number = self.block_number.saturating_add(1);
        self.last_block_at = chrono::Utc::now().timestamp();
        let hash = self.header().hash();
        self.last_block_hash = hash;
    }

    /// Taille sérialisée du BlockOrb (octets)
    pub fn taille_octets(&self) -> usize {
        serde_json::to_string(self).map(|s| s.len()).unwrap_or(0)
    }

    /// Vérifie la règle de taille fixe
    pub fn taille_ok(&self) -> bool {
        self.taille_octets() <= crate::blockchain_lib::MAX_BLOCKORB_BYTES
    }
    
    /// Somme des 6 Cases
    pub fn somme_cases(&self) -> u128 {
        self.cases.iter().sum()
    }
    
    /// Somme des comptes (normal + cadeaux)
    pub fn somme_comptes(&self) -> u128 {
        self.comptes.values().map(|p| p.solde).sum::<u128>() + self.comptes_cadeaux.values().sum::<u128>()
    }
    
    /// Total (doit être 40 Md)
    pub fn total(&self) -> u128 {
        self.somme_cases() + self.ubi_enveloppe + self.somme_comptes()
    }
    
    /// Vérifie l'invariant (avec tolérance pour les arrondis)
    pub fn verifier(&self) -> bool {
        let total = self.total();
        let capacite = CAPACITE_TOTALE;
        
        let diff = if total > capacite {
            total - capacite
        } else {
            capacite - total
        };
        
        // Tolerance : 0.1 FXB = 10^17 femto
        // (pour absorber les arrondis de conversion USD -> FXB)
        let tolerance = 1_000_000_000_000_000_000u128;
        
        diff <= tolerance
    }
    
    /// Traite une transaction (u128 = ultra rapide)
    pub fn traiter(
        &mut self,
        from: &str,
        to: &str,
        montant: MontantFxB,
    ) -> Result<(), String> {
        // 1. Vérifier le solde source
        let solde_from = self.comptes.get(from).map(|p| p.solde).unwrap_or(0);
        if solde_from < montant.0 {
            return Err(format!(
                "Solde insuffisant : {} < {}",
                solde_from, montant.0
            ));
        }
        
        // 2. Sauvegarder pour rollback
        let solde_to = self.comptes.get(to).map(|p| p.solde).unwrap_or(0);
        
        // 3. Débiter et créditer
        let p_from = self.comptes.entry(from.to_string()).or_insert_with(Portefeuille::new);
        p_from.solde = solde_from - montant.0;
        
        let p_to = self.comptes.entry(to.to_string()).or_insert_with(Portefeuille::new);
        p_to.solde = solde_to + montant.0;
        
        // 4. Vérifier l'invariant
        if !self.verifier() {
            // ROLLBACK
            let p_from = self.comptes.entry(from.to_string()).or_insert_with(Portefeuille::new);
            p_from.solde = solde_from;
            
            let p_to = self.comptes.entry(to.to_string()).or_insert_with(Portefeuille::new);
            p_to.solde = solde_to;
            return Err("Invariant cassé — ROLLBACK".to_string());
        }
        
        // 5. Sceller le bloc (numéro + horodatage + hash de chaînage)
        self.sceller_bloc();
        
        Ok(())
    }
    
    /// Distribue les frais aux 6 Cases
    pub fn distribuer_frais(&mut self, frais: u128) -> Result<(), String> {
        // Distribution : 30/40/15/10/5/0
        let parts = [
            frais * 30 / 100,  // Océan
            frais * 40 / 100,  // Nuages
            frais * 15 / 100,  // Rivières
            frais * 10 / 100,  // Glaciers
            frais * 5 / 100,   // Nappes
            0,                 // Vapeur
        ];
        
        // Ajouter aux Cases
        for (i, part) in parts.iter().enumerate() {
            self.cases[i] = self.cases[i]
                .checked_add(*part)
                .ok_or("Dépassement u128 dans les Cases")?;
        }
        
        // Vérifier l'invariant
        if !self.verifier() {
            return Err("Invariant cassé après distribution".to_string());
        }
        
        Ok(())
    }
    
    /// Crée un nouveau compte
    pub fn creer_compte(&mut self, uq_number: &str, solde_initial: u128) {
        let p = self.comptes.entry(uq_number.to_string()).or_insert_with(Portefeuille::new);
        p.solde = solde_initial;
    }
    
    /// 🎁 Crédite le solde CADEAUX (parrainage, UBI)
    pub fn crediter_cadeau(&mut self, uq_number: &str, montant: u128) -> Result<(), String> {
        // 1. Vérifier l'enveloppe si c'est un UBI
        // (Fait par le handler UBI)
        
        // 2. Créditer
        let solde = self.comptes_cadeaux.get(uq_number).copied().unwrap_or(0);
        self.comptes_cadeaux.insert(uq_number.to_string(), solde + montant);
        
        // 3. Vérifier l'invariant
        if !self.verifier() {
            self.comptes_cadeaux.insert(uq_number.to_string(), solde);
            return Err("Invariant casse apres credit cadeau".to_string());
        }
        
        Ok(())
    }
    
    /// 🎁 Solde CADEAUX d'un utilisateur
    pub fn solde_cadeaux(&self, uq_number: &str) -> u128 {
        self.comptes_cadeaux.get(uq_number).copied().unwrap_or(0)
    }
    
    /// 🎁 Transferer depuis le solde CADEAUX
    pub fn traiter_cadeau(&mut self, from: &str, to: &str, montant: u128) -> Result<(), String> {
        // 1. Vérifier le solde cadeaux
        let solde_from = self.comptes_cadeaux.get(from).copied().unwrap_or(0);
        if solde_from < montant {
            return Err(format!("Solde cadeaux insuffisant: {} < {}", solde_from, montant));
        }
        
        let solde_to = self.comptes_cadeaux.get(to).copied().unwrap_or(0);
        
        // 2. Débiter/créditer
        self.comptes_cadeaux.insert(from.to_string(), solde_from - montant);
        self.comptes_cadeaux.insert(to.to_string(), solde_to + montant);
        
        // 3. Vérifier l'invariant
        if !self.verifier() {
            self.comptes_cadeaux.insert(from.to_string(), solde_from);
            self.comptes_cadeaux.insert(to.to_string(), solde_to);
            return Err("Invariant casse — ROLLBACK".to_string());
        }
        
        Ok(())
    }
}


impl BlockOrb {
    /// Get solde d'un compte (compatibilite)
    pub fn get_solde(&self, uq_number: &str) -> u128 {
        self.comptes.get(uq_number).map(|p| p.solde).unwrap_or(0)
    }

    /// Set solde d'un compte
    pub fn set_solde(&mut self, uq_number: &str, solde: u128) {
        self.comptes.entry(uq_number.to_string())
            .or_insert_with(Portefeuille::new)
            .solde = solde;
    }

    /// Ajouter a un compte
    pub fn ajouter_solde(&mut self, uq_number: &str, montant: u128) -> Result<(), String> {
        let p = self.comptes.entry(uq_number.to_string())
            .or_insert_with(Portefeuille::new);
        p.ajouter(montant)
    }

    /// Retirer d'un compte
    pub fn retirer_solde(&mut self, uq_number: &str, montant: u128) -> Result<(), String> {
        let p = self.comptes.get_mut(uq_number)
            .ok_or("Compte introuvable")?;
        p.retirer(montant)
    }

    /// Sommer les soldes
    pub fn somme_soldes(&self) -> u128 {
        self.comptes.values().map(|p| p.solde).sum()
    }
}

impl Default for BlockOrb {
    fn default() -> Self {
        Self::new()
    }
}

