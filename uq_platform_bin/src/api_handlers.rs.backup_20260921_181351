pub async fn bubble_create(
    state: web::Data<Arc<GlobalState>>,
    body: web::Json<serde_json::Value>,
) -> HttpResponse {
    let owner = body.get("owner").and_then(|v| v.as_str()).unwrap_or("UQ-00000001");
    let amount = body.get("amount_micro").and_then(|v| v.as_u64()).unwrap_or(0);
    
    // Creer une bulle dans BubbleRegistry
    let mut registry = state.bubble_registry.lock().unwrap();
    
    let owner_bytes = {
        let mut addr = [0u8; 32];
        let bytes = owner.as_bytes();
        for i in 0..32 {
            if i < bytes.len() {
                addr[i] = bytes[i];
            }
        }
        addr
    };
    
    match registry.create_bubble(
        owner_bytes,
        owner_bytes,
        amount,
        Vec::new(),
        |data| {
            use sha2::{Sha256, Digest};
            let mut hasher = Sha256::new();
            hasher.update(data);
            hasher.finalize().to_vec()
        },
    ) {
        Ok(bubble) => HttpResponse::Ok().json(json!({
            "status": "success",
            "bubble_created": true,
            "bubble_id": format!("{:?}", &bubble.id[..8]),
            "amount_micro": amount
        })),
        Err(e) => HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": format!("{}", e)
        })),
    }
}
pub async fn bubble_transfer(
    req: actix_web::HttpRequest,
    state: web::Data<Arc<GlobalState>>,
    body: web::Json<TransferRequest>,
) -> HttpResponse {
    match crate::auth::AuthManager::require_role(&req, &["user", "admin", "guardian"]) {
        Ok(_claims) => {
            let sender = body.sender.clone();
            let recipient = body.recipient.clone();
            let amount = body.amount_points;
            let fee = body.fee_points;
            let total_cost = amount + fee;
            let amount_fxb = amount / 100;  // Conversion points → FXB
            
            let sender_db_path = format!("data/users/{}.db", sender.replace("-", "_").to_lowercase());
            let recipient_db_path = format!("data/users/{}.db", recipient.replace("-", "_").to_lowercase());
            
            if !std::path::Path::new(&sender_db_path).exists() {
                return HttpResponse::BadRequest().json(json!({
                    "status": "error",
                    "message": format!("Compte expediteur introuvable: {}", sender)
                }));
            }
            if !std::path::Path::new(&recipient_db_path).exists() {
                return HttpResponse::BadRequest().json(json!({
                    "status": "error",
                    "message": format!("Compte destinataire introuvable: {}", recipient)
                }));
            }
            
            // OUVRIR SENDER
            let sender_conn = match rusqlite::Connection::open(&sender_db_path) {
                Ok(c) => c,
                Err(e) => return HttpResponse::InternalServerError().json(json!({
                    "status": "error",
                    "message": format!("Erreur ouverture sender: {}", e)
                })),
            };
            
            let sender_balance: i64 = match sender_conn.query_row(
                "SELECT points FROM balance WHERE id = 1",
                [],
                |row| row.get(0),
            ) {
                Ok(b) => b,
                Err(_) => 0,
            };
            
            if sender_balance < total_cost as i64 {
                return HttpResponse::BadRequest().json(json!({
                    "status": "error",
                    "message": format!("Solde insuffisant. Solde: {} points, Requis: {} points", sender_balance, total_cost)
                }));
            }
            
            let now = chrono::Utc::now().timestamp();
            
            // DÉBITER LE SENDER
            if let Err(e) = sender_conn.execute(
                "UPDATE balance SET points = points - ?1, updated_at = ?2 WHERE id = 1",
                rusqlite::params![total_cost as i64, now],
            ) {
                return HttpResponse::InternalServerError().json(json!({
                    "status": "error",
                    "message": format!("Erreur debit sender: {}", e)
                }));
            }
            
            let tx_hash = {
                use sha2::{Sha256, Digest};
                let mut hasher = Sha256::new();
                hasher.update(format!("{}:{}:{}:{}", sender, recipient, amount, now).as_bytes());
                hex::encode(hasher.finalize())
            };
            
            // ENREGISTRER TRANSACTION SEND
            match sender_conn.execute(
                "INSERT INTO transactions (tx_type, amount, fee, counterparty, memo, created_at)
                 VALUES ('send', ?1, ?2, ?3, ?4, ?5)",
                rusqlite::params![amount as i64, fee as i64, recipient, tx_hash, now],
            ) {
                Ok(_) => eprintln!("✅ Transaction send enregistrée pour {}", sender),
                Err(e) => eprintln!("❌ Erreur INSERT send: {}", e),
            }
            
            // METTRE À JOUR my_fixorb_units[FXB] DU SENDER (en FXB, pas en points)
            match sender_conn.execute(
                "UPDATE my_fixorb_units SET balance = balance - ?1, updated_at = ?2 WHERE unit = 'FXB'",
                rusqlite::params![amount_fxb as i64, now],
            ) {
                Ok(_) => eprintln!("✅ my_fixorb_units SENDER mis à jour: -{} FXB", amount_fxb),
                Err(e) => eprintln!("❌ Erreur UPDATE my_fixorb_units SENDER: {}", e),
            }
            
            // OUVRIR RECIPIENT
            let recipient_conn = match rusqlite::Connection::open(&recipient_db_path) {
                Ok(c) => c,
                Err(e) => return HttpResponse::InternalServerError().json(json!({
                    "status": "error",
                    "message": format!("Erreur ouverture recipient: {}", e)
                })),
            };
            
            // CRÉDITER LE RECIPIENT
            if let Err(e) = recipient_conn.execute(
                "UPDATE balance SET points = points + ?1, updated_at = ?2 WHERE id = 1",
                rusqlite::params![amount as i64, now],
            ) {
                return HttpResponse::InternalServerError().json(json!({
                    "status": "error",
                    "message": format!("Erreur credit recipient: {}", e)
                }));
            }
            
            // ENREGISTRER TRANSACTION RECEIVE
            match recipient_conn.execute(
                "INSERT INTO transactions (tx_type, amount, fee, counterparty, memo, created_at)
                 VALUES ('receive', ?1, 0, ?2, ?3, ?4)",
                rusqlite::params![amount as i64, sender, tx_hash, now],
            ) {
                Ok(_) => eprintln!("✅ Transaction receive enregistrée pour {}", recipient),
                Err(e) => eprintln!("❌ Erreur INSERT receive: {}", e),
            }
            
            // METTRE À JOUR my_fixorb_units[FXB] DU RECIPIENT
            match recipient_conn.execute(
                "UPDATE my_fixorb_units SET balance = balance + ?1, updated_at = ?2 WHERE unit = 'FXB'",
                rusqlite::params![amount_fxb as i64, now],
            ) {
                Ok(_) => eprintln!("✅ my_fixorb_units RECIPIENT mis à jour: +{} FXB", amount_fxb),
                Err(e) => eprintln!("❌ Erreur UPDATE my_fixorb_units RECIPIENT: {}", e),
            }
            
            // PERSISTER DANS SQLITE GLOBAL
            let db = Database::shared("uq_platform_db.json");
            db.record_transaction(&sender, &recipient, amount, fee);
            
            HttpResponse::Ok().json(json!({
                "status": "success",
                "persisted": true,
                "blockchain": true,
                "amount": amount,
                "fee": fee,
                "tx_hash": tx_hash,
                "sender_new_balance": sender_balance - total_cost as i64,
                "message": "Transfert effectue et persiste dans les tables"
            }))
        }
        Err(resp) => resp,
    }
}
