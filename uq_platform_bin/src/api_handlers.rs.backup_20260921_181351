pub async fn account_create(
    state: web::Data<Arc<GlobalState>>,
    body: web::Json<serde_json::Value>,
) -> HttpResponse {
    // ═══════════════════════════════════════════════════════════
    // 1. EXTRAIRE LES DONNÉES DU BODY
    // ═══════════════════════════════════════════════════════════
    let uq_number = body.get("uq_number").and_then(|v| v.as_str()).unwrap_or("");
    let email = body.get("email").and_then(|v| v.as_str()).unwrap_or("");
    let pseudo = body.get("pseudo").and_then(|v| v.as_str()).unwrap_or("");
    let password = body.get("password").and_then(|v| v.as_str()).unwrap_or("");
    let full_name = body.get("full_name").and_then(|v| v.as_str()).unwrap_or("");
    
    // ═══════════════════════════════════════════════════════════
    // 2. GÉNÉRER UN UQ_NUMBER SI NON FOURNI
    // ═══════════════════════════════════════════════════════════
    let index = uq_index::UqIndex::shared("uq_index.db");
    let count = index.count();
    let generated_number = if uq_number.is_empty() {
        format!("UQ-{:08}", count + 100)  // Commence à 100 pour éviter les conflits
    } else {
        uq_number.to_string()
    };
    
    let generated_email = if email.is_empty() {
        format!("user{}@zando.uq", count + 100)
    } else {
        email.to_string()
    };
    
    let generated_pseudo = if pseudo.is_empty() {
        format!("uq@user{}", count + 100)
    } else {
        pseudo.to_string()
    };
    
    // ═══════════════════════════════════════════════════════════
    // 3. CRÉER LE FICHIER .DB AVEC LES 46 TABLES
    // ═══════════════════════════════════════════════════════════
    let db_filename = generated_number.replace("-", "_").to_lowercase();
    let db_path = format!("data/users/{}.db", db_filename);
    
    // Créer le dossier data/users s'il n'existe pas
    if let Err(e) = std::fs::create_dir_all("data/users") {
        eprintln!("Erreur création dossier data/users: {}", e);
    }
    
    // CRÉER LE FICHIER .DB AVEC LES 46 TABLES
    if let Err(e) = uq_index::UqIndex::init_user_db(&db_path) {
        eprintln!("Erreur création base utilisateur: {}", e);
        return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur création base: {}", e)
        }));
    }
    
    eprintln!("✅ Base créée: {} (46 tables)", db_path);
    
    // ═══════════════════════════════════════════════════════════
    // 4. INSÉRER DANS uq_index
    // ═══════════════════════════════════════════════════════════
    let salt = format!("uq_{}_salt", generated_number.to_lowercase().replace("-", "_"));
    let hash_password = uq_index::UqIndex::hash_password(
        if password.is_empty() { "changeme123" } else { password },
        &salt
    );
    let hash_identity = uq_index::UqIndex::hash_identity(
        full_name,
        "",
        "RDC",
        0
    );
    
    if let Err(e) = index.insert_account(
        &generated_number,
        &generated_email,
        &generated_pseudo,
        &hash_identity,
        &hash_password,
        &salt,
        &[0u8; 32],  // public_key (à remplacer par la vraie clé)
        false,       // is_owner
        &db_path,
    ) {
        eprintln!("Erreur insertion uq_index: {}", e);
        return HttpResponse::InternalServerError().json(json!({
            "status": "error",
            "message": format!("Erreur index: {}", e)
        }));
    }
    
    eprintln!("✅ Compte inséré dans uq_index: {}", generated_number);
    
    // ═══════════════════════════════════════════════════════════
    // 5. CRÉER DANS SQLITE GLOBAL (pour compatibilité)
    // ═══════════════════════════════════════════════════════════
    let db = Database::shared("uq_platform_db.json");
    db.create_account(&generated_number, &[0u8; 32]);
    
    // ═══════════════════════════════════════════════════════════
    // 6. CRÉER DANS GlobalState
    // ═══════════════════════════════════════════════════════════
    match state.create_account() {
        Ok(_) => HttpResponse::Ok().json(json!({
            "status": "success",
            "account_created": true,
            "uq_number": generated_number,
            "email": generated_email,
            "pseudo": generated_pseudo,
            "db_path": db_path,
            "balance_fxb": 0,
            "message": "Compte créé avec 46 tables. 0 FXB. Utilisez un code promo pour gagner 1 FXB."
        })),
        Err(e) => HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": format!("{}", e)
        })),
    }
}
