pub async fn ubi_claim(
    state: web::Data<Arc<GlobalState>>,
) -> HttpResponse {
    // 1. Recuperer le compte du UQ-00000001
    let address = {
        let mut addr = [0u8; 32];
        let bytes = b"UQ-00000001";
        for i in 0..32.min(bytes.len()) {
            addr[i] = bytes[i];
        }
        addr
    };
    
    // 2. Verifier si eligible
    let current_time = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs() as i64;
    
    let mut ubi_pool = state.ubi_pool.lock().unwrap();
    
    match ubi_pool.claim_ubi(&address, 30, true, current_time) {
        Ok(amount) => {
            drop(ubi_pool);
            
            // Crediter la bulle
            let mut registry = state.bubble_registry.lock().unwrap();
            // (Le credit est fait via le UbiPool dans la vraie implementation)
            
            HttpResponse::Ok().json(json!({
                "status": "success",
                "amount_points": amount,
                "message": "UBI reclame avec succes"
            }))
        }
        Err(e) => HttpResponse::BadRequest().json(json!({
            "status": "error",
            "message": format!("{}", e)
        })),
    }
}
